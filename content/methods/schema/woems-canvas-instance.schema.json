{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/schemas/woems-canvas-instance.schema.json",
  "title": "WÖMS Canvas-Instanz",
  "type": "object",
  "required": [
    "canvasId",
    "methodId",
    "version",
    "datum",
    "fall",
    "verantwortlicheModeration",
    "evidenzstatus",
    "unsicherheit",
    "negativeWirkung",
    "wirkungsgrenzen",
    "offeneFragen",
    "semantischeCodierung"
  ],
  "properties": {
    "canvasId": { "type": "string", "minLength": 1 },
    "methodId": { "type": "string", "pattern": "^[A-H][0-9]{2}$" },
    "version": { "type": "string", "minLength": 1 },
    "datum": { "type": "string", "format": "date" },
    "fall": { "type": "string", "minLength": 1 },
    "verantwortlicheModeration": { "type": "string", "minLength": 1 },
    "evidenzstatus": { "type": "string", "minLength": 1 },
    "unsicherheit": { "type": "string", "minLength": 1 },
    "negativeWirkung": { "type": "array", "items": { "type": "string" } },
    "wirkungsgrenzen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bezeichnung", "status"],
        "properties": {
          "bezeichnung": { "type": "string", "minLength": 1 },
          "status": { "enum": ["eingehalten", "gefaehrdet", "verletzt"] },
          "begruendung": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "offeneFragen": { "type": "array", "items": { "type": "string" } },
    "semantischeCodierung": {
      "type": "object",
      "required": ["farbeNieAllein", "zusaetzlicheCodierung"],
      "properties": {
        "farbeNieAllein": { "const": true },
        "zusaetzlicheCodierung": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["Text", "Symbol"] }
        }
      },
      "additionalProperties": false
    },
    "felder": { "type": "object" },
    "aggregierterWert": { "type": ["number", "null"] }
  },
  "additionalProperties": false
}

[Unit]
Description=Consistent private WÖk survey backup (seven-day retention)
After=faktencheck-bot.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/faktencheck-bot
EnvironmentFile=/opt/faktencheck-bot/.env
ExecStart=/usr/bin/node /opt/faktencheck-bot/polls/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/faktencheck-bot/data/polls /opt/faktencheck-bot/backups/polls

# Add to the EXISTING Oracle service environment; never commit real values.
POLLS_ENABLED=true
POLLS_DATABASE_PATH=/opt/faktencheck-bot/data/polls/polls.sqlite
POLLS_ABUSE_DATABASE_PATH=/opt/faktencheck-bot/data/polls/abuse.sqlite
POLLS_BACKUP_DIRECTORY=/opt/faktencheck-bot/backups/polls
POLLS_TOKEN_PEPPER=GENERATE_A_PRIVATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
POLLS_ABUSE_PEPPER=GENERATE_A_DIFFERENT_PRIVATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Enable only after verifying the local reverse proxy REPLACES X-Real-IP.
POLLS_TRUST_LOCAL_PROXY=false
# Optional: comma-separated Discord user IDs; existing signed login and current
# membership remain required. If empty, current guild owner/Administrator only.
POLLS_ADMIN_DISCORD_IDS=

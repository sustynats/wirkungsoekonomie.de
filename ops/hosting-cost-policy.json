{
  "policy_version": "1.1.0",
  "effective_date": "2026-09-09",
  "provider_selection": {
    "vercel_is_default": false,
    "alternatives_must_be_assessed": ["GITHUB", "ORACLE_OCI"],
    "new_or_expanded_vercel_requires_technical_necessity": true,
    "existing_hosting_is_not_technical_necessity": true,
    "automatic_plan_change_allowed": false,
    "new_paid_exception_requires_project_owner_approval": true
  },
  "monthly_budget": {
    "currency": "EUR",
    "target": 0,
    "gross_max": 25,
    "ceiling_is_spending_authorization": false,
    "increase_requires_project_owner_approval": true,
    "vercel_spend_management_additional_usd_preferred": 0,
    "vercel_spend_management_additional_usd_fallback_max": 1,
    "vercel_spend_management_action": "PAUSE_ALL_PROJECTS",
    "metered_effective_cost_before_new_build_usd_max": 15,
    "build_cpu_effective_cost_before_new_build_usd_max": 10,
    "additional_billed_cost_before_new_build_usd_max": 0.5
  },
  "vercel": {
    "automatic_git_deployments": false,
    "automatic_preview_deployments": false,
    "production_release_mode": "MANUAL_COMMIT_BOUND_PROMOTION",
    "build_machine_type": "standard",
    "build_machine_selection": "fixed",
    "elastic_concurrency_enabled": false,
    "build_queue": "WAIT_FOR_NAMESPACE_QUEUE",
    "permitted_roles": [
      "PRODUCTION_WEB_RUNTIME",
      "EXPLICIT_RELEASE_CANDIDATE"
    ],
    "forbidden_roles": [
      "CANONICAL_DATA_STORE",
      "PRIMARY_PUBLIC_ARTIFACT_STORE",
      "GIT_PUSH_PREVIEW_CI"
    ]
  },
  "storage": {
    "public_artifacts": "GITHUB_RELEASES",
    "public_source_and_history": "GITHUB",
    "private_user_data_target": "ORACLE_OCI",
    "legacy_store_migration": "BACKUP_FIRST_NO_SILENT_DELETE",
    "new_private_user_data_in_vercel_storage": false
  },
  "migration": {
    "backup_first": true,
    "restore_test_required": true,
    "capacity_and_zero_additional_cost_check_required": true,
    "functional_and_access_parity_required": true,
    "rollback_required": true,
    "stop_existing_service_for_cost_policy_alone": false,
    "downgrade_requires_dependency_and_limit_audit": true,
    "operational_evidence_visibility": "PRIVATE_ONLY"
  },
  "release": {
    "preview_default": "DISABLED",
    "production_requires_exact_commit": true,
    "production_requires_quality_gates": true,
    "production_requires_smoke_test": true,
    "deploy_hooks_require_explicit_release_authorization": true,
    "monthly_vercel_build_limit_all_projects": 4,
    "release_candidate_builds_per_change_set_max": 1,
    "production_must_promote_existing_release_candidate": true,
    "direct_vercel_deploy_commands_forbidden_without_release_budget_gate": true,
    "emergency_override_requires_project_owner_approval": true
  }
}

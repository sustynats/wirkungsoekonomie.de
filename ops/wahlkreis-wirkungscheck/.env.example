# Copy this file to .env with scripts/create-local-env.sh before starting locally.
# Never commit .env. Replace the domains and sender contact before production use.

COMPOSE_PROJECT_NAME=woek-wahlkreis
TZ=Europe/Berlin

# Public endpoints. Keep CRM and survey on separate subdomains, never paths.
CRM_DOMAIN=crm.wirkungsoekonomie.de
SURVEY_DOMAIN=umfrage.wirkungsoekonomie.de
CADDY_EMAIL=wirkungscheck@wirkungsoekonomie.de

# CiviCRM database
CRM_DB_NAME=civicrm
CRM_DB_USER=civicrm
CRM_DB_PASSWORD=CHANGE_ME
CRM_DB_ROOT_PASSWORD=CHANGE_ME

# LimeSurvey database and first administrator
SURVEY_DB_NAME=limesurvey
SURVEY_DB_USER=limesurvey
SURVEY_DB_PASSWORD=CHANGE_ME
SURVEY_DB_ROOT_PASSWORD=CHANGE_ME
SURVEY_ADMIN_USER=admin
SURVEY_ADMIN_PASSWORD=CHANGE_ME
SURVEY_ADMIN_NAME=Wirkungsökonomie
SURVEY_ADMIN_EMAIL=wirkungscheck@wirkungsoekonomie.de

# Isolated analytics database. This service stores no contact, invitation or answer data.
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=CHANGE_ME
ANALYTICS_STUDY_ID=BT_2026
ANALYTICS_WAVE_ID=W1
ANALYTICS_SURVEY_VERSION=1.0
ANALYTICS_RAW_TTL_HOURS=72
MIN_ANALYTICS_COHORT_SIZE=10
ENABLE_PARTY_RESEARCH_ANALYTICS=false
ANALYTICS_ALLOWED_ORIGINS=https://umfrage.wirkungsoekonomie.de

# Set only after CiviCRM is installed and its scheduled-job URL has been created.
# CIVICRM_CRON_URL=https://crm.wirkungsoekonomie.de/extern/rest.php?key=...&api_key=...&entity=Job&action=execute

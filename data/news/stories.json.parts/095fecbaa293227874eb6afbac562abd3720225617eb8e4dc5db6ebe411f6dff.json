icial_rss","published_at":"2026-10-14T06:00:00.000Z","primary_source":true,"source_priority":95,"source_topic":"Wirtschaft","content_hash":"92641520f11d702c315069f7f7709094591e86082a62ea69189a96f61daa4536","source_item_id":"c25a619848db50666020014cc66118adf901048f84b85d482511fec88b382e03","publisher_id":"destatis-aktuell","publisher_kind":"institution","source_role":"institutional_statement","language":"de","geography":["DE"],"research_lane":"primary","requires_corroboration":false,"source_published_at":"2026-10-14T06:00:00.000Z","ingested_at":"2026-10-14T06:03:02.906Z","agency_origin":"unknown","agency_origin_confidence":"unknown","provenance":{"origin":"publisher:destatis-aktuell","basis":"publisher_only_origin_unverified","independence_established":false}}],"claims":[{"claim_id":"wt-25ef39c804112343-claim-01","story_id":"wt-25ef39c804112343","claim":"Erzeugerpreise landwirtschaftlicher Produkte im August 2026: -7,0 % gegenüber August 2025: Die Erzeugerpreise landwirtschaftlicher Produkte waren im August 2026 um 7,0 % niedriger als im August 2025. Im Juli 2026 hatte die Veränderungsrate gegenüber dem Vorjahresmonat bei -13,7 % gelegen, im Juni 2026 bei -13,9 %. Wie das Statistische Bundesamt (Destatis) weiter mitteilt, stiegen die Erzeugerpreise landwirtschaftlicher Produkte im August 2026 gegenüber Juli 2026 um 5,5 %. Das war der stärkste Anstieg im Vormonatsvergleich seit März 2022 (+13,1 % zum Vormonat), als nach dem Beginn des russischen Angriffs auf die Ukraine unter anderem die Getreidepreise sprunghaft gestiegen waren.","claim_type":"Zurechenbare Quellenaussage; noch keine unabhängige Bestätigung","source_id":"destatis-aktuell","source_function":"institutional_statement","status":"primary_source_claim","provenance":{"origin":"publisher:destatis-aktuell","basis":"publisher_only_origin_unverified","independence_established":false},"evidence_level":"Primärquelle","data_status":"Feed-Kurztext vorhanden","attribution":"Aussage der verlinkten Quelle; keine unabhä
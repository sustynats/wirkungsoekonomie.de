[["3a60cdd5ef05b4db3838f84b358d435820d04c8083e9e9e59b67d755e5d9ed8b",{"source_id":"dlf-nachrichten","publisher":"Deutschlandfunk","url":"https://www.deutschlandfunk.de/17-jaehrige-chinesin-sprintet-in-rekordzeit-zu-gold-elfjaehriger-gewinnt-e-sport-titel-kritik-am-ver-102.html","title":"Asienspiele in Japan - 17-jährige Chinesin sprintet in Rekordzeit zu Gold, Elfjähriger gewinnt E-Sport-Titel - Kritik am Veranstalter","summary":"Bei den Asienspielen im japanischen Nagoya-Aichi haben eine chinesische Sprinterin und ein elfjähriges E-Sport-Talent für Aufsehen gesorgt. Die erst 17-jährige Chen Yujie gewann Gold über 100 Meter und stellte dabei einen Rekord für die Asienspiele auf. Der Japaner Yuki Kurihara sicherte sich den Titel im E-Sport-Wettbewerb \"Puyo Puyo Champions\".","source_type":"media_rss","published_at":"2026-09-26T11:47:33.000Z","primary_source":false,"source_priority":0,"source_topic":"Politik","content_hash":"f2b8084687707b4d5934e8218fcc50401d9566965241f75c84bf5bfd2366a84d","source_item_id":"3a60cdd5ef05b4db3838f84b358d435820d04c8083e9e9e59b67d755e5d9ed8b","publisher_id":"deutschlandfunk","publisher_kind":"public_broadcasting","source_role":"journalistic_report","language":"de","geography":["DE","international"],"research_lane":"media","requires_corroboration":false,"source_published_at":"2026-09-26T11:47:33.000Z","ingested_at":"2026-09-26T11:54:45.353Z","agency_origin":"unknown","agency_origin_confidence":"unknown","provenance":{"origin":"publisher:deutschlandfunk","basis":"publisher_only_origin_unverified","independence_established":false},"event_id":"event-944cb319c01012eace32","first_seen_at":"2026-09-26T11:54:45.353Z","last_seen_at":"2026-09-26T11:54:45.353Z"}]]
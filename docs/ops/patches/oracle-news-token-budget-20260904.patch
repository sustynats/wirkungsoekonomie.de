@@ -0,0 +1,20 @@
+import { describe, expect, it } from 'vitest';
+import { reconcileLegacyNewsBudget } from '../src/scripts/migrateNewsBudget.js';
+describe('audited legacy migration',()=>{
+  const global={version:1,months:{'2026-09':{estimatedCents:5000,totalRequests:625,features:{'woek-ai':{requests:625,estimatedCents:5000}}}}};
+  const news={version:1,months:{'2026-09':{chargedUsd:7.130904,requests:576}}};
+  const proof={runs:[{run_id:'proof-1',started_at:'2026-09-04T15:00:00Z',ai:{token_source:'provider_reported_usage',requests:531,input_tokens:100000}}]};
+  it('replaces only documented flat charges and keeps unknown old costs plus the full news journal',()=>{
+    const migrated=reconcileLegacyNewsBudget(global,news,proof,'2026-09');
+    expect(migrated.migration.retained_legacy_reserve_cents).toBe(752);
+    expect(migrated.months['2026-09'].estimatedCents).toBeGreaterThan(1600);
+    expect(migrated.months['2026-09'].estimatedCents).toBeLessThan(1800);
+    expect(global.version).toBe(1);
+    expect(reconcileLegacyNewsBudget(migrated,news,proof,'2026-09')).toBe(migrated);
+  });
+  it('rejects missing, duplicate or excessive proof rather than resetting counters',()=>{
+    expect(()=>reconcileLegacyNewsBudget(global,news,{runs:[]},'2026-09')).toThrow();
+    expect(()=>reconcileLegacyNewsBudget(global,news,{runs:[...proof.runs,...proof.runs]},'2026-09')).toThrow();
+    expect(()=>reconcileLegacyNewsBudget(global,news,{runs:[{...proof.runs[0],ai:{...proof.runs[0]!.ai,requests:626}}]},'2026-09')).toThrow();
+  });
+});

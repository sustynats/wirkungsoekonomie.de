+import { afterEach, describe, expect, it } from 'vitest';
+import { mkdtemp, readFile, writeFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { UsageBudgetTracker, USD_TO_GROSS_EUR_CENTS } from '../src/services/tokenUsageBudget.js';
+import { FactcheckProviderError } from '../src/services/openaiFactcheck.js';
+const dirs: string[] = [];
+afterEach(async () => { for (const dir of dirs.splice(0)) await rm(dir, { recursive:true, force:true }); });
+async function fixture(limit = 5000) {
+  const dir = await mkdtemp(join(tmpdir(), 'token-budget-')); dirs.push(dir);
+  const file = join(dir, 'budget.json');
+  const budget = new UsageBudgetTracker({ enabled:true, file, monthlyBudgetCents:limit, featureCostsCents:{ factcheck:20, woekAi:8, productCheck:35 } });
+  return {file,budget};
+}
+const result = {model:'gpt-5.4-mini',usage:{input_tokens:1000,output_tokens:1000,cached_input_tokens:0}};
+describe('token cost accounting', () => {
+  it('reserves durably, reconciles tokens instead of charging 8 cents, and assigns an ID', async () => {
+    const {file,budget} = await fixture();
+    await budget.withBudget('news-analysis', async () => {
+      const state = JSON.parse(await readFile(file,'utf8'));
+      expect(state.entries[0].id).toBeTruthy();
+      expect(state.entries[0].chargedCents).toBeGreaterThan(33);
+      return result;
+    });
+    const state = JSON.parse(await readFile(file,'utf8'));
+    expect(state.entries[0].chargedCents).toBeCloseTo(0.00525 * USD_TO_GROSS_EUR_CENTS,5);
+    expect(state.entries[0].usage).toEqual(result.usage);
+    expect(state.entries[0].basis).toBe('provider_tokens_with_fx_tax_reserve');
+  });
+  it('concurrent requests cannot overspend one available reservation', async () => {
+    const {budget} = await fixture(40);
+    let finish!:()=>void;
+    const waiting = new Promise<void>(resolve=>finish=resolve);
+    const first = budget.withBudget('news-analysis', async()=>{await waiting;return result});
+    await expect(budget.withBudget('news-analysis',async()=>result)).rejects.toMatchObject({technicalMessage:'monthly_budget_reached'});
+    finish(); await first;
+  });
+  it('keeps interrupted and missing-usage reservations, releases proven local rejections', async () => {
+    const {file,budget} = await fixture();
+    await expect(budget.withBudget('news-analysis',async()=>{throw new Error('timeout')})).rejects.toThrow('timeout');
+    await budget.withBudget('news-analysis',async()=>({}));

@@ -0,0 +1,32 @@
+import { createHash } from 'node:crypto';
+import { readFile, writeFile, rename } from 'node:fs/promises';
+import { pathToFileURL } from 'node:url';
+import { USD_TO_GROSS_EUR_CENTS } from '../services/tokenUsageBudget.js';
+
+export function reconcileLegacyNewsBudget(global: any, news: any, proof: any, month: string) {
+  if (global.migration?.id === 'news-token-costs-20260904') return global;
+  if (global.version !== 1 || news.version !== 1) throw new Error('Unexpected ledger versions');
+  const before=global.months?.[month], newsMonth=news.months?.[month];
+  if (!before || !Number.isFinite(newsMonth?.chargedUsd) || newsMonth.chargedUsd < 0 || !Array.isArray(proof.runs)) throw new Error('Missing migration evidence');
+  const certified=proof.runs.filter((r:any)=>r.started_at?.startsWith(month) && r.started_at >= '2026-09-03T22:21:17.010Z' && r.ai?.token_source==='provider_reported_usage');
+  if (new Set(certified.map((r:any)=>r.run_id)).size !== certified.length || certified.some((r:any)=>!Number.isInteger(r.ai.requests)||r.ai.requests<1||!Number.isFinite(r.ai.input_tokens)||r.ai.input_tokens<1)) throw new Error('Invalid or duplicate usage evidence');
+  const calls=certified.reduce((sum:number,r:any)=>sum+r.ai.requests,0);
+  const oldWoek=before.features?.['woek-ai'];
+  if (!calls || calls>oldWoek?.requests || calls*8>oldWoek?.estimatedCents || calls>newsMonth.requests) throw new Error('Usage evidence exceeds legacy counters');
+  const converted=Math.ceil(newsMonth.chargedUsd*USD_TO_GROSS_EUR_CENTS*1e6)/1e6;
+  const state=structuredClone(global);
+  state.version=2;state.entries=[];
+  state.months[month].estimatedCents=before.estimatedCents-calls*8+converted;
+  state.months[month].features['woek-ai']={requests:oldWoek.requests-calls,estimatedCents:oldWoek.estimatedCents-calls*8};
+  state.months[month].features['news-analysis']={requests:calls,estimatedCents:converted};
+  state.migration={id:'news-token-costs-20260904',month,at:new Date().toISOString(),original_estimated_cents:before.estimatedCents,removed_documented_flat_charge_cents:calls*8,documented_successful_news_calls:calls,imported_news_ledger_usd:newsMonth.chargedUsd,retained_legacy_reserve_cents:before.estimatedCents-calls*8,proof_sha256:createHash('sha256').update(JSON.stringify(proof)).digest('hex'),note:'Unknown older costs retained as reserves. News journal includes its historical and interrupted-request reserves; no invoice-precision claim.'};
+  return state;
+}
+if (process.argv[1] && import.meta.url===pathToFileURL(process.argv[1]).href) {
+  const [globalPath,newsPath,proofPath,mode]=process.argv.slice(2);
+  if (!globalPath||!newsPath||!proofPath||!['--dry-run','--apply'].includes(mode||'')) throw new Error('Usage: migrateNewsBudget <global> <news> <proof> --dry-run|--apply; stop service and back up both journals first');
+  const [global,news,proof]=await Promise.all([globalPath,newsPath,proofPath].map(async p=>JSON.parse(await readFile(p,'utf8'))));
+  const state=reconcileLegacyNewsBudget(global,news,proof,new Date().toISOString().slice(0,7));
+  console.log(JSON.stringify({migration:state.migration,current:state.months[new Date().toISOString().slice(0,7)]},null,2));
+  if(mode==='--apply'){await writeFile(`${globalPath}.migration.tmp`,JSON.stringify(state,null,2)+'\n',{mode:0o600});await rename(`${globalPath}.migration.tmp`,globalPath)}
+}
diff --git a/src/services/tokenUsageBudget.ts b/src/services/tokenUsageBudget.ts
new file mode 100644
index 0000000..e4c0e9f
--- /dev/null
+++ b/src/services/tokenUsageBudget.ts
@@ -0,0 +1,98 @@
+import { randomUUID } from "node:crypto";
+import { mkdir, readFile, rename, writeFile } from "node:fs/promises";
+import { dirname } from "node:path";
+import { FactcheckProviderError } from "./openaiFactcheck.js";
+import type { ApiFeature, UsageBudgetOptions } from "./usageBudget.js";
+type BudgetFeature = ApiFeature | "news-analysis";
+interface FeatureTotals { requests: number; estimatedCents: number }
+interface MonthTotals { totalRequests: number; estimatedCents: number; features: Partial<Record<BudgetFeature, FeatureTotals>>; updatedAt: string }
+interface Entry { id: string; feature: BudgetFeature; month: string; at: string; chargedCents: number; basis: string; model?: string; usage?: unknown }
+interface State { version: 2; months: Record<string, MonthTotals>; entries: Entry[]; migration?: unknown }
+// Conservative accounting conversion, not an asserted current FX rate: $1 is
+// reserved as EUR 1, plus 19% tax and the existing 10% FX safety buffer.
+export const USD_TO_GROSS_EUR_CENTS = 100 * 1.19 / 0.9;
+const cents = (n: number) => Math.ceil(n * 1e6) / 1e6;
+
+export class UsageBudgetTracker {
+  private queue: Promise<unknown> = Promise.resolve();
+  constructor(private readonly options: UsageBudgetOptions) {}
+  async withBudget<T>(feature: BudgetFeature, action: () => Promise<T>): Promise<T> {
+    if (!this.options.enabled) return action();
+    const id = randomUUID();
+    const month = new Date().toISOString().slice(0, 7);
+    await this.mutate(state => {
+      const current = state.months[month] ??= emptyMonth();
+      const reserve = feature === 'news-analysis' ? cents(0.25 * USD_TO_GROSS_EUR_CENTS) : Math.max(35, this.legacyEstimate(feature));
+      if (current.estimatedCents + reserve > this.options.monthlyBudgetCents) throw new FactcheckProviderError('Das monatliche KI-Budget ist ausgeschöpft.', 429, 'monthly_budget_reached');
+      state.entries.push({ id, feature, month, at: new Date().toISOString(), chargedCents: reserve, basis: 'reserved_unknown' });
+      this.charge(current, feature, reserve, 1);
+    });
+    let result: T;
+    try { result = await action(); }
+    catch (error) {
+      if (error instanceof FactcheckProviderError && error.technicalMessage === 'news_monthly_budget_reached') await this.reconcile(id, 0, 'local_budget_rejection');
+      throw error;
+    }
+    const record = result as { cacheStatus?: string; mode?: string; provider?: string; model?: string; usage?: { input_tokens?: number; output_tokens?: number; cached_input_tokens?: number } } | undefined;
+    const cached = record?.cacheStatus === 'hit' || /cache/i.test(record?.mode || '') || /cache/i.test(record?.provider || '');
+    if (cached) await this.reconcile(id, 0, 'cache_hit');
+    else if (record?.model === 'gpt-5.4-mini' && validUsage(record.usage)) {
+      const usage = record.usage!;
+      const cachedTokens = Math.min(usage.input_tokens!, usage.cached_input_tokens || 0);
+      const usd = ((usage.input_tokens! - cachedTokens) * 0.75 + cachedTokens * 0.075 + usage.output_tokens! * 4.5) / 1e6;
+      await this.reconcile(id, cents(usd * USD_TO_GROSS_EUR_CENTS), 'provider_tokens_with_fx_tax_reserve', record.model, usage);
+    }
+    // Unknown models, usage or interrupted requests retain their reservation.
+    return result;
+  }
+  async currentMonth(): Promise<MonthTotals> {
+    await this.queue;
+    return (await this.readState()).months[new Date().toISOString().slice(0, 7)] ?? emptyMonth();
+  }
+  private legacyEstimate(feature: ApiFeature): number {
+    return feature === 'factcheck' ? this.options.featureCostsCents.factcheck : feature === 'product-check' ? this.options.featureCostsCents.productCheck : this.options.featureCostsCents.woekAi;
+  }
+  private charge(month: MonthTotals, feature: BudgetFeature, amount: number, requests: number) {
+    const totals = month.features[feature] ??= { requests: 0, estimatedCents: 0 };
+    month.estimatedCents = cents(month.estimatedCents + amount);
+    month.totalRequests += requests;
+    totals.estimatedCents = cents(totals.estimatedCents + amount);
+    totals.requests += requests;
+    month.updatedAt = new Date().toISOString();
+  }
+  private reconcile(id: string, amount: number, basis: string, model?: string, usage?: unknown) {
+    return this.mutate(state => {
+      const entry = state.entries.find(entry => entry.id === id);
+      if (!entry || entry.basis !== 'reserved_unknown') throw new Error('Budget reservation missing or already reconciled');
+      this.charge(state.months[entry.month]!, entry.feature, amount - entry.chargedCents, 0);
+      Object.assign(entry, { chargedCents: amount, basis, model, usage });
+    });
+  }
+  private mutate(change: (state: State) => void) {
+    const operation = this.queue.then(async () => {
+      const state = await this.readState();
+      change(state);
+      await mkdir(dirname(this.options.file), { recursive: true });
+      const temporary = `${this.options.file}.tmp`;
+      await writeFile(temporary, JSON.stringify(state, null, 2) + '\n', { mode: 0o600 });
+      await rename(temporary, this.options.file);
+    });
+    this.queue = operation.catch(() => undefined);
+    return operation;
+  }
+  private async readState(): Promise<State> {
+    let parsed;
+    try { parsed = JSON.parse(await readFile(this.options.file, 'utf8')); }
+    catch (error) {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') return { version: 2, months: {}, entries: [] };
+      throw error;
+    }
+    if (![1, 2].includes(parsed.version) || !parsed.months || Object.values(parsed.months).some((m: any) => !Number.isFinite(m.estimatedCents) || m.estimatedCents < 0 || !m.features)) throw new Error('Invalid API budget ledger');
+    // Preserve the entire old estimate until the explicit audited migration.
+    return { ...parsed, version: 2, entries: parsed.entries || [] };
+  }
+}
+function emptyMonth(): MonthTotals { return { totalRequests: 0, estimatedCents: 0, features: {}, updatedAt: new Date().toISOString() }; }
+function validUsage(usage: any): boolean {
+  return usage && Number.isInteger(usage.input_tokens) && usage.input_tokens >= 0 && Number.isInteger(usage.output_tokens) && usage.output_tokens >= 0 && (usage.cached_input_tokens === undefined || Number.isInteger(usage.cached_input_tokens) && usage.cached_input_tokens >= 0 && usage.cached_input_tokens <= usage.input_tokens);
+}

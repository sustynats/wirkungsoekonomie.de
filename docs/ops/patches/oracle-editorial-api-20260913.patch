+import {afterEach,expect,it} from 'vitest';
+import {mkdtemp,readFile,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {UsageBudgetTracker,USD_TO_GROSS_EUR_CENTS} from '../src/services/tokenUsageBudget.js';
+import {NewsAnalysisBudget} from '../src/services/newsAnalysisBudget.js';
+import {FactcheckProviderError} from '../src/services/openaiFactcheck.js';
+const dirs:string[]=[];
+afterEach(async()=>{for(const dir of dirs.splice(0))await rm(dir,{recursive:true,force:true});});
+it.each([[false,'gpt-5.4-mini',.02525],[true,'gpt-5.4-mini',.02525],[false,'gpt-5.6-luna',.0214],[true,'gpt-5.6-luna',.0214]] as const)('reserves both ledgers and bills verified model/search tariff (%s, %s)',async (reject,model,cost)=>{
+ const dir=await mkdtemp(join(tmpdir(),'research-cost-'));dirs.push(dir);
+ const sharedFile=join(dir,'shared.json'),newsFile=join(dir,'news.json');
+ const shared=new UsageBudgetTracker({enabled:true,file:sharedFile,monthlyBudgetCents:5000,featureCostsCents:{factcheck:20,woekAi:8,productCheck:35}});
+ const news=new NewsAnalysisBudget(newsFile,20);
+ const evidence={model,usage:{input_tokens:1000,output_tokens:1000,cached_input_tokens:0,web_search_calls:2}};
+ const month=new Date().toISOString().slice(0,7);
+ const result=shared.withBudget('news-analysis',()=>news.withBudget(async()=>{
+   expect(JSON.parse(await readFile(newsFile,'utf8')).months[month].chargedUsd).toBe(.5);
+   expect(JSON.parse(await readFile(sharedFile,'utf8')).months[month].estimatedCents).toBeCloseTo(.5*USD_TO_GROSS_EUR_CENTS,5);
+   if(reject)throw new FactcheckProviderError('invalid',502,'api_editorial_invalid_json',evidence);
+   return evidence;
+ },.5),.5);
+ if(reject)await expect(result).rejects.toThrow('invalid');else await result;
+ expect(JSON.parse(await readFile(newsFile,'utf8')).months[month].chargedUsd).toBeCloseTo(cost,6);
+ expect(JSON.parse(await readFile(sharedFile,'utf8')).months[month].estimatedCents).toBeCloseTo(cost*USD_TO_GROSS_EUR_CENTS,5);
+});

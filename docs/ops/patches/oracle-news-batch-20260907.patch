+  reserveBatch(id: string, amount = 0.125): Promise<void> {
+    if (!/^[a-f0-9]{64}$/.test(id) || amount !== 0.125) return Promise.reject(new Error('Invalid batch reservation'));
+    return this.mutateBatch(state => {
+      state.batchReservations ??= {};
+      const previous = state.batchReservations[id];
+      if (previous && !previous.settled) return;
+      if (previous?.chargedUsd) throw new Error('batch_input_reservation_closed');
+      const month = this.now().toISOString().slice(0, 7);
+      const current = state.months[month] ??= { chargedUsd: 0, requests: 0 };
+      const limit = this.monthlyLimitsUsd[month] ?? this.limitUsd;
+      // Leave room for current news. Background work must not consume the last slots.
+      if (!Number.isFinite(current.chargedUsd) || current.chargedUsd + amount + 1 > limit) throw new FactcheckProviderError('Nachrichtenbudget hat keine Hintergrundreserve.', 429, 'news_monthly_budget_reached');
+      current.chargedUsd = Number((current.chargedUsd + amount).toFixed(6));
+      current.requests += 1;
+      state.batchReservations[id] = { month, reservedUsd: amount, chargedUsd: amount, settled: false };
+    });
+  }
+
+  settleBatch(id: string, costUsd: number): Promise<void> {
+    if (!Number.isFinite(costUsd) || costUsd < 0) return Promise.reject(new Error('Invalid batch cost'));
+    return this.mutateBatch(state => {
+      const entry = state.batchReservations?.[id];
+      if (!entry) throw new Error('Batch reservation missing');
+      const amount = Number(costUsd.toFixed(6));
+      if (entry.settled) {
+        if (entry.chargedUsd !== amount) throw new Error('Batch billing mismatch');
+        return;
+      }
+      const month = state.months[entry.month]!;
+      month.chargedUsd = Number((month.chargedUsd - entry.chargedUsd + amount).toFixed(6));
+      entry.chargedUsd = amount;
+      entry.settled = true;
+    });
+  }

+
+  async reserveBatch(key: string): Promise<void> {
+    if (!this.options.enabled) throw new Error('Batch requires shared budget guard');
+    if (!/^[a-f0-9]{64}$/.test(key)) throw new Error('Invalid batch key');
+    await this.mutate(state => {
+      const id = `batch:${key}`;

+++ b/src/services/newsBatchService.ts
@@ -0,0 +1,221 @@
+import { createHash } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname } from 'node:path';
+import { buildNewsroomRequest, readNewsroomOutput } from './openaiWoekAi.js';
+import { miniUsageUsd, validProviderUsage, type ProviderTokenUsage } from './providerUsage.js';
+import type { NewsAnalysisBudget } from './newsAnalysisBudget.js';
+import type { UsageBudgetTracker } from './tokenUsageBudget.js';
+import { FactcheckProviderError } from './openaiFactcheck.js';
+
+const MODEL = 'gpt-5.4-mini';
+const RESERVE = 0.125;
+const terminal = new Set(['completed', 'failed', 'expired', 'cancelled']);
+type Kind = 'media_backfill' | 'editorial_background';
+export interface NewsBatchInput { key: string; kind: Kind; story_id: string; fingerprint: string; question: string; attempt: number }
+interface Job {
+  key: string; kind: Kind; story_id: string; fingerprint: string; created_at: string;
+  prompt_hash: string; attempt: number;
+  state: 'reserved' | 'creating' | 'submitted' | 'completed' | 'failed' | 'unknown';
+  input_file_id?: string; batch_id?: string; provider_status?: string; checked_at?: string;
+  settled?: boolean; cost_usd?: number; usage?: ProviderTokenUsage; answer?: string;
+  error?: string; files_cleaned?: boolean; output_file_id?: string; error_file_id?: string;
+}
+interface Store { version: 1; jobs: Record<string, Job> }
+export interface BatchBudgets {
+  news: Pick<NewsAnalysisBudget, 'reserveBatch' | 'settleBatch'>;
+  shared: Pick<UsageBudgetTracker, 'reserveBatch' | 'settleBatch'>;
+}
+
+// Private Oracle job metadata uses the existing atomic JSON-store pattern. It
+// is not a second publishing queue and never directly changes public stories.
+export class NewsBatchService {
+  private queue: Promise<unknown> = Promise.resolve();
+  constructor(private readonly options: { file: string; apiKey: string; budgets: BatchBudgets; fetchImpl?: typeof fetch; now?: () => Date }) {}
+  private now(): string { return (this.options.now?.() || new Date()).toISOString(); }
+  private serial<T>(action: () => Promise<T>): Promise<T> {
+    const operation = this.queue.then(action);
+    this.queue = operation.catch(() => undefined);
+    return operation;
+  }
+
+  list() {
+    return this.serial(async () => Object.values((await this.read()).jobs)
+      .filter(job => !job.settled || Date.parse(this.now()) - Date.parse(job.created_at) < 7 * 86400000)
+      .sort((a, b) => Number(a.settled) - Number(b.settled) || Date.parse(b.created_at) - Date.parse(a.created_at))
+      .slice(0, 100).map(job => { const { answer: _answer, ...metadata } = this.view(job); return metadata; }));
+  }
+
+  submit(input: NewsBatchInput) {
+    return this.serial(async () => {
+      this.validate(input);
+      const store = await this.read();
+      if (store.jobs[input.key]) return this.view(store.jobs[input.key]!);
+      const jobs = Object.values(store.jobs);
+      if (jobs.filter(job => !['completed', 'failed'].includes(job.state)).length >= 4
+        || jobs.filter(job => job.created_at.slice(0, 10) === this.now().slice(0, 10)).length >= 8) {
+        throw new FactcheckProviderError('Hintergrundkapazität belegt.', 429, 'batch_capacity');
+      }
+      // Reserve both existing ledgers before uploading or submitting a job.
+      await this.options.budgets.shared.reserveBatch(input.key);
+      try { await this.options.budgets.news.reserveBatch(input.key); }
+      catch (error) { await this.options.budgets.shared.settleBatch(input.key, 0); throw error; }
+      const job: Job = { key: input.key, kind: input.kind, story_id: input.story_id, fingerprint: input.fingerprint, prompt_hash: createHash('sha256').update(input.question).digest('hex'), attempt: input.attempt, created_at: this.now(), state: 'reserved' };
+      store.jobs[input.key] = job;
+      await this.save(store);
+      try {
+        const body = buildNewsroomRequest({ question: input.question }, MODEL, input.kind === 'editorial_background' ? 10000 : 6500);
+        const form = new FormData();
+        form.append('purpose', 'batch');
+        // Only one already-filtered job per input file. No need to accumulate
+        // news to qualify for the Batch tariff or to fill an arbitrary quota.
+        form.append('file', new Blob([JSON.stringify({ custom_id: job.key, method: 'POST', url: '/v1/responses', body }) + '\n'], { type: 'application/jsonl' }), 'woek-news-background.jsonl');
+        const file = await this.api('/files', { method: 'POST', body: form });
+        if (!/^file-[A-Za-z0-9_-]+$/.test(file?.id || '')) throw new Error('batch_file_invalid');
+        job.input_file_id = file.id;
+        // Write-ahead marker: a timeout/crash from here may have created a
+        // paid job. Never repeat POST /batches speculatively after a restart.
+        job.state = 'creating';
+        await this.save(store);
+        const batch = await this.api('/batches', { method: 'POST', body: JSON.stringify({ input_file_id: file.id, endpoint: '/v1/responses', completion_window: '24h', metadata: { woek_news_key: job.key, kind: job.kind } }) });
+        this.bind(job, batch);
+      } catch (error) {
+        if (job.state === 'reserved' || [400, 401, 403, 413, 422].includes(Number((error as { status?: number }).status))) {
+          job.state = 'failed'; job.error = 'BATCH_SUBMISSION_REJECTED'; job.cost_usd = 0;
+          await this.settle(job);
+        } else { job.state = 'unknown'; job.error = 'BATCH_SUBMISSION_UNCERTAIN'; }
+      }
+      await this.save(store);
+      return this.view(job);
+    });
+  }
+
+  get(key: string) {
+    return this.serial(async () => {
+      if (!/^[a-f0-9]{64}$/.test(key)) throw new Error('batch_key_invalid');
+      const store = await this.read();
+      const job = store.jobs[key];
+      if (!job) return null;
+      if (['completed', 'failed'].includes(job.state)) {
+        await this.settle(job);
+        await this.save(store);
+        await this.cleanup(job);
+        await this.save(store);
+        return this.view(job);
+      }
+      if (Date.parse(this.now()) - Date.parse(job.checked_at || '') < 5 * 60000) return this.view(job);
+      job.checked_at = this.now();
+      if (!job.batch_id) {
+        if (job.state === 'reserved') {
+          // Durable state proves POST /batches was never reached.
+          job.state = 'failed'; job.error = 'BATCH_NOT_SUBMITTED'; job.cost_usd = 0;
+          await this.settle(job);
+        } else {
+          // Recover only our exact metadata+file pair; unrelated batches are
+          // not exposed. Uncertain submissions keep reserves, never duplicate.
+          let after = '';
+          for (let page = 0; page < 3 && !job.batch_id; page += 1) {
+            const list = await this.api(`/batches?limit=100${after ? `&after=${encodeURIComponent(after)}` : ''}`);
+            const matches = (Array.isArray(list.data) ? list.data : []).filter((b: any) => b.metadata?.woek_news_key === key && b.input_file_id === job.input_file_id);
+            if (matches.length === 1) this.bind(job, matches[0]);
+            if (matches.length > 1) { job.error = 'BATCH_IDENTITY_CONFLICT'; break; }
+            if (!list.has_more || !list.last_id) break;
+            after = String(list.last_id);
+          }
+        }
+      }
+      if (job.batch_id) {
+        const batch = await this.api(`/batches/${job.batch_id}`);
+        this.bind(job, batch);
+        job.provider_status = String(batch.status);
+        if (terminal.has(batch.status)) {
+          job.output_file_id = batch.output_file_id || undefined;
+          job.error_file_id = batch.error_file_id || undefined;
+          let line;
+          if (batch.output_file_id) {
+            if (!/^file-[A-Za-z0-9_-]+$/.test(batch.output_file_id)) throw new Error('batch_file_invalid');
+            const output = await this.api(`/files/${batch.output_file_id}/content`, {}, true);
+            const lines = String(output).trim().split('\n').filter(Boolean).map(value => JSON.parse(value));
+            if (lines.length !== 1 || lines[0]?.custom_id !== job.key) throw new Error('batch_result_identity_mismatch');
+            line = lines[0];
+          }
+          const body = line?.response?.body;
+          const usage = body?.usage && { input_tokens: body.usage.input_tokens, output_tokens: body.usage.output_tokens, cached_input_tokens: body.usage.input_tokens_details?.cached_tokens ?? 0 };
+          const modelMatches = body?.model === MODEL || /^gpt-5\.4-mini-\d{4}-\d{2}-\d{2}$/.test(body?.model || '');
+          if (modelMatches && validProviderUsage(usage)) {
+            job.usage = usage;
+            job.cost_usd = Number((miniUsageUsd({ model: MODEL, usage })! * 0.5).toFixed(6));
+          } else if (!line && ['failed', 'expired', 'cancelled'].includes(batch.status)
+            && batch.request_counts?.completed === 0 && [0, 1].includes(batch.request_counts?.total)) {
+            job.cost_usd = 0;
+          }
+          try {
+            if (line?.response?.status_code !== 200 || !modelMatches || body?.status !== 'completed') throw new Error('batch_output_invalid');
+            job.answer = readNewsroomOutput(body);
+            job.state = 'completed'; delete job.error;
+          } catch { job.state = 'failed'; job.error = 'AI_PROVIDER_OUTPUT_INVALID'; }
+          await this.settle(job);
+          // Persist the recovered paid output BEFORE deleting provider files.
+          await this.save(store);
+          // Only the identified input/output files of a terminal job can go.
+          await this.cleanup(job);
+        }
+      }
+      await this.save(store);
+      return this.view(job);
+    });
+  }
+
+  private validate(input: NewsBatchInput) {
+    if (!input || !['media_backfill', 'editorial_background'].includes(input.kind) || !/^[a-f0-9]{64}$/.test(input.fingerprint)
+      || !/^[a-zA-Z0-9_-]{1,100}$/.test(input.story_id) || typeof input.question !== 'string' || input.question.length < 20 || input.question.length > 40000
+      || !Number.isInteger(input.attempt) || input.attempt < 0 || input.attempt > 2) throw new Error('batch_input_invalid');
+    const key = createHash('sha256').update(JSON.stringify({ version: 1, kind: input.kind, story_id: input.story_id, fingerprint: input.fingerprint, question: input.question, attempt: input.attempt })).digest('hex');
+    if (key !== input.key) throw new Error('batch_input_identity_mismatch');
+  }
+  private bind(job: Job, batch: any) {
+    if (!/^batch_[A-Za-z0-9_-]+$/.test(batch?.id || '') || batch.input_file_id !== job.input_file_id
+      || batch.metadata?.woek_news_key !== job.key || batch.endpoint !== '/v1/responses' || job.batch_id && job.batch_id !== batch.id) throw new Error('batch_identity_mismatch');
+    job.batch_id = batch.id; job.state = 'submitted'; delete job.error;
+  }
+  private async settle(job: Job) {
+    if (job.settled || job.cost_usd === undefined) return;
+    await this.options.budgets.news.settleBatch(job.key, job.cost_usd);
+    await this.options.budgets.shared.settleBatch(job.key, job.cost_usd);
+    job.settled = true;
+  }
+  private async cleanup(job: Job) {
+    // Keep provider evidence when billing is unresolved, including malformed output.
+    if (job.files_cleaned || !job.settled || !['completed', 'failed'].includes(job.state)) return;
+    let ok = true;
+    for (const id of [job.input_file_id, job.output_file_id, job.error_file_id].filter(Boolean)) {
+      if (!/^file-[A-Za-z0-9_-]+$/.test(id!)) { ok = false; continue; }
+      try { await this.api(`/files/${id}`, { method: 'DELETE' }); }
+      catch (error) { if ((error as { status?: number }).status !== 404) ok = false; }
+    }
+    job.files_cleaned = ok;
+  }
+  private view(job: Job) {
+    return { key: job.key, kind: job.kind, story_id: job.story_id, fingerprint: job.fingerprint, created_at: job.created_at,
+      prompt_hash: job.prompt_hash, attempt: job.attempt,
+      status: job.state, provider_status: job.provider_status, error: job.error, reserved_usd: RESERVE,
+      estimated_cost_usd: job.settled ? job.cost_usd : RESERVE, billing_status: job.settled ? 'settled' : 'reserved',
+      model: MODEL, processing_mode: 'batch', usage: job.usage, ...(job.state === 'completed' ? { answer: job.answer } : {}) };
+  }
+  private async api(route: string, options: RequestInit = {}, text = false): Promise<any> {
+    const result = await (this.options.fetchImpl || fetch)(`https://api.openai.com/v1${route}`, { ...options, redirect: 'error', signal: AbortSignal.timeout(20000),
+      headers: { Authorization: `Bearer ${this.options.apiKey}`, ...(options.body instanceof FormData ? {} : { 'Content-Type': 'application/json' }) } });
+    if (!result.ok) throw Object.assign(new Error(`batch_provider_http_${result.status}`), { status: result.status });
+    const data = await result.text();
+    if (data.length > 2_000_000) throw new Error('batch_response_too_large');
+    return text ? data : JSON.parse(data);
+  }
+  private async read(): Promise<Store> {
+    try { const s = JSON.parse(await readFile(this.options.file, 'utf8')); if (s.version !== 1 || !s.jobs) throw new Error('batch_store_invalid'); return s; }
+    catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return { version: 1, jobs: {} }; throw error; }
+  }
+  private async save(store: Store) {
+    await mkdir(dirname(this.options.file), { recursive: true });
+    await writeFile(`${this.options.file}.tmp`, JSON.stringify(store) + '\n', { mode: 0o600 });
+    await rename(`${this.options.file}.tmp`, this.options.file);
+  }
+}

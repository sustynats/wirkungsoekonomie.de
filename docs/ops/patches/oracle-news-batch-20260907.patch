+      const reserve = cents(0.125 * USD_TO_GROSS_EUR_CENTS);
+      if (current.estimatedCents + reserve + 150 > this.options.monthlyBudgetCents) throw new FactcheckProviderError('Keine gemeinsame Hintergrundreserve.', 429, 'monthly_budget_reached');
+      const reservation: Entry = { id, feature: 'news-analysis', month, at: new Date().toISOString(), chargedCents: reserve, basis: 'batch_reserved' };
+      if (previous) Object.assign(previous, reservation); else state.entries.push(reservation);
+      this.charge(current, 'news-analysis', reserve, 1);
+    });
+  }
+
+  async settleBatch(key: string, costUsd: number): Promise<void> {
+    if (!Number.isFinite(costUsd) || costUsd < 0) throw new Error('Invalid batch cost');
+    await this.mutate(state => {
+      const entry = state.entries.find(entry => entry.id === `batch:${key}`);
+      if (!entry) throw new Error('Batch reservation missing');
+      const amount = cents(costUsd * USD_TO_GROSS_EUR_CENTS);
+      if (entry.basis !== 'batch_reserved') {
+        if (entry.basis !== 'batch_reconciled' || entry.chargedCents !== amount) throw new Error('Batch billing mismatch');
+        return;
+      }
+      this.charge(state.months[entry.month]!, entry.feature, amount - entry.chargedCents, 0);
+      Object.assign(entry, { chargedCents: amount, basis: 'batch_reconciled', model: 'gpt-5.4-mini' });
+    });
+  }

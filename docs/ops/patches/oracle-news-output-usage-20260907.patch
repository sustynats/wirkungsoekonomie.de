+import { afterEach, expect, it, vi } from 'vitest';
+import { readConfig } from '../src/config.js';
+
+afterEach(()=>vi.unstubAllEnvs());
+it('requires finite, month-bound override configuration', () => {
+  vi.stubEnv('DISCORD_TOKEN', 'test'); vi.stubEnv('DISCORD_CLIENT_ID', 'test');
+  vi.stubEnv('NEWS_MONTHLY_BUDGET_OVERRIDES_USD_CENTS', undefined);
+  expect(readConfig().newsMonthlyBudgetOverridesUsdCents).toEqual({});
+  vi.stubEnv('NEWS_MONTHLY_BUDGET_OVERRIDES_USD_CENTS', '{"2026-09":3781}');
+  expect(readConfig().newsMonthlyBudgetOverridesUsdCents).toEqual({'2026-09':3781});
+  for (const value of ['null', '[]', '{"2026-13":3781}', '{"2026-09":-1}', '{"2026-09":"3781"}', '{"2026-09":1.1}', '{"2026-09":1e999}', 'broken']) {
+    vi.stubEnv('NEWS_MONTHLY_BUDGET_OVERRIDES_USD_CENTS', value);
+    expect(() => readConfig()).toThrow('NEWS_MONTHLY_BUDGET_OVERRIDES_USD_CENTS');
+  }
+});
+it('keeps the authorized default and allows an explicit finite server limit without rebuilding',()=>{
+  vi.stubEnv('DISCORD_TOKEN','test');vi.stubEnv('DISCORD_CLIENT_ID','test');
+  vi.stubEnv('NEWS_MONTHLY_BUDGET_USD_CENTS',undefined);
+  expect(readConfig().newsMonthlyBudgetUsdCents).toBe(1890);
+  vi.stubEnv('NEWS_MONTHLY_BUDGET_USD_CENTS','1800');
+  expect(readConfig().newsMonthlyBudgetUsdCents).toBe(1800);
+  for (const value of ['-1','Infinity','NaN','18.9','100oops','9007199254740992']) {
+    vi.stubEnv('NEWS_MONTHLY_BUDGET_USD_CENTS',value);
+    expect(()=>readConfig()).toThrow('NEWS_MONTHLY_BUDGET_USD_CENTS');
+  }

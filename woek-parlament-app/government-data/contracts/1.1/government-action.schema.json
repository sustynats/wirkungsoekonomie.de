{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/government-action-1.1.schema.json",
  "title": "WÖk GovernmentAction 1.1",
  "type": "object",
  "required": [
    "government_action_id",
    "government_term_id",
    "title_canonical",
    "title_official_preferred",
    "action_type",
    "responsible_ministries",
    "responsible_institutions",
    "lifecycle_status",
    "source_event_ids",
    "official_identifiers",
    "fach_review_status",
    "publication_status",
    "source_integrity_status",
    "coverage_scope_status",
    "duplicate_cluster_id",
    "review_notes",
    "reviewed_at",
    "review_method",
    "review_rule_id",
    "schema_version"
  ],
  "properties": {
    "government_action_id": {"type": "string", "minLength": 1},
    "government_term_id": {"const": "bund-2025"},
    "title_canonical": {"type": "string", "minLength": 1},
    "title_official_preferred": {"type": "string", "minLength": 1},
    "action_type": {"type": "string"},
    "responsible_ministries": {"type": "array", "items": {"type": "string"}},
    "responsible_institutions": {"type": "array", "items": {"type": "string"}},
    "first_known_date": {"type": ["string", "null"]},
    "cabinet_decision_date": {"type": ["string", "null"]},
    "submitted_to_parliament_date": {"type": ["string", "null"]},
    "promulgated_date": {"type": ["string", "null"]},
    "effective_date": {"type": ["string", "null"]},
    "lifecycle_status": {"type": "string"},
    "lifecycle_events": {"type": "array"},
    "source_event_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "official_identifiers": {"type": "object"},
    "legal_basis_refs": {"type": "array"},
    "coalition_commitment_refs": {"type": "array"},
    "parliamentary_case_refs": {"type": "array"},
    "budget_refs": {"type": "array"},
    "funding_refs": {"type": "array"},
    "procurement_refs": {"type": "array"},
    "related_government_action_ids": {"type": "array"},
    "relationship_review_status": {"type": "string"},
    "source_completeness": {"type": "string"},
    "canonicalization_notes": {"type": "array"},
    "manual_review_required": {"type": "boolean"},
    "materiality_signals": {"type": "object"},
    "field_provenance": {"type": "array"},
    "fach_review_status": {
      "enum": ["UNREVIEWED", "CONFIRMED_ACTION", "SOURCE_ONLY", "DUPLICATE", "REJECTED", "NEEDS_SOURCE"]
    },
    "publication_status": {
      "enum": ["BLOCKED", "INTERNAL", "READY_FACT_LAYER", "READY_WOEK_EX_ANTE", "READY_IMPLEMENTATION", "READY_EX_POST"]
    },
    "source_integrity_status": {"enum": ["PASS", "PARTIAL", "BLOCKED", "UNKNOWN"]},
    "coverage_scope_status": {
      "enum": ["COMPLETE_ENUMERATED_SOURCE", "BEST_EFFORT_DEFINED_SOURCE_SCOPE", "PARTIAL", "SOURCE_UNAVAILABLE", "UNKNOWN"]
    },
    "duplicate_cluster_id": {"type": ["string", "null"]},
    "review_notes": {"type": "array", "items": {"type": "string"}},
    "reviewed_at": {"type": ["string", "null"]},
    "review_method": {"enum": ["RULE", "MANUAL", "HYBRID", "NONE"]},
    "review_rule_id": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "schema_version": {"const": "1.1"}
  },
  "additionalProperties": true
}

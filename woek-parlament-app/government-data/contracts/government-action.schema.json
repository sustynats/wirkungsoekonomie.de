{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/government-action-1.0.schema.json",
  "title": "WÖk GovernmentAction 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["government_action_id", "government_term_id", "title_canonical", "title_official_preferred", "action_type", "responsible_ministries", "responsible_institutions", "lifecycle_status", "lifecycle_events", "source_event_ids", "official_identifiers", "legal_basis_refs", "coalition_commitment_refs", "parliamentary_case_refs", "budget_refs", "funding_refs", "procurement_refs", "related_government_action_ids", "relationship_review_status", "source_completeness", "canonicalization_notes", "manual_review_required", "materiality_signals", "field_provenance", "created_at", "updated_at", "schema_version"],
  "properties": {
    "government_action_id": {"type": "string", "minLength": 1},
    "government_term_id": {"const": "bund-2025"},
    "title_canonical": {"type": "string", "minLength": 1},
    "title_official_preferred": {"type": "string", "minLength": 1},
    "action_type": {"enum": ["CABINET_DECISION", "GOVERNMENT_BILL", "REGULATION", "ADMINISTRATIVE_RULE", "STRATEGY", "ACTION_PLAN", "GOVERNMENT_PROGRAMME", "FUNDING_PROGRAMME", "BUDGET_ACTION", "IMPLEMENTATION_ACTION", "PROCUREMENT_ACTION", "STATE_OWNERSHIP_ACTION", "INTERNATIONAL_POSITION", "INTERNATIONAL_AGREEMENT", "GOVERNMENT_REPORT", "GOVERNANCE_ORGANISATION", "COMMUNICATION", "OTHER"]},
    "responsible_ministries": {"type": "array", "items": {"type": "string"}},
    "responsible_institutions": {"type": "array", "items": {"type": "string"}},
    "first_known_date": {"type": ["string", "null"]},
    "cabinet_decision_date": {"type": ["string", "null"]},
    "submitted_to_parliament_date": {"type": ["string", "null"]},
    "promulgated_date": {"type": ["string", "null"]},
    "effective_date": {"type": ["string", "null"]},
    "lifecycle_status": {"enum": ["ANNOUNCED", "MINISTRY_DRAFT", "CONSULTATION", "CABINET_DECIDED", "SUBMITTED_TO_PARLIAMENT", "PARLIAMENTARY_PROCESS", "ADOPTED", "PROMULGATED", "IN_FORCE", "IMPLEMENTING", "MONITORED", "EVALUATED", "WITHDRAWN", "SUPERSEDED", "UNKNOWN"]},
    "lifecycle_events": {"type": "array", "items": {"type": "object"}},
    "source_event_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "official_identifiers": {"type": "object", "required": ["dip_ids", "drucksachen", "eli", "bgbl", "other"], "properties": {"dip_ids": {"type": "array"}, "drucksachen": {"type": "array"}, "eli": {"type": "array"}, "bgbl": {"type": "array"}, "other": {"type": "array"}}},
    "legal_basis_refs": {"type": "array"},
    "coalition_commitment_refs": {"type": "array"},
    "parliamentary_case_refs": {"type": "array"},
    "budget_refs": {"type": "array"},
    "funding_refs": {"type": "array"},
    "procurement_refs": {"type": "array"},
    "related_government_action_ids": {"type": "array"},
    "relationship_review_status": {"enum": ["CONFIRMED", "REVIEW_REQUIRED", "REJECTED", "NONE"]},
    "source_completeness": {"enum": ["COMPLETE_ENUMERATED_SOURCE", "BEST_EFFORT_DEFINED_SOURCE_SCOPE", "PARTIAL", "SOURCE_UNAVAILABLE", "UNKNOWN"]},
    "canonicalization_notes": {"type": "array", "items": {"type": "string"}},
    "manual_review_required": {"type": "boolean"},
    "materiality_signals": {"type": "object"},
    "field_provenance": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "schema_version": {"const": "1.0"}
  }
}


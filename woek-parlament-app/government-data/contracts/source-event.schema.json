{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/source-event-1.0.schema.json",
  "title": "WÖk SourceEvent 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_event_id", "source_id", "event_type", "retrieved_at", "source_url", "title_original", "attachments", "official_identifiers", "named_institutions", "named_ministries", "named_legal_acts", "named_programmes", "raw_blob_sha256", "parser_version", "parse_status", "parse_warnings", "source_version_status", "source_function", "provenance"],
  "properties": {
    "source_event_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "external_id": {"type": ["string", "null"]},
    "event_type": {"type": "string", "minLength": 1},
    "published_at": {"type": ["string", "null"]},
    "effective_at": {"type": ["string", "null"]},
    "retrieved_at": {"type": "string", "minLength": 1},
    "first_seen_at": {"type": ["string", "null"]},
    "last_seen_at": {"type": ["string", "null"]},
    "source_url": {"type": "string", "pattern": "^https://"},
    "canonical_source_url": {"type": ["string", "null"]},
    "title_original": {"type": "string", "minLength": 1},
    "summary_original": {"type": ["string", "null"]},
    "body_text_original": {"type": ["string", "null"]},
    "attachments": {"type": "array", "items": {"type": "object"}},
    "official_identifiers": {"type": "object"},
    "named_institutions": {"type": "array", "items": {"type": "string"}},
    "named_ministries": {"type": "array", "items": {"type": "string"}},
    "named_legal_acts": {"type": "array", "items": {"type": "string"}},
    "named_programmes": {"type": "array", "items": {"type": "string"}},
    "raw_blob_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "previous_content_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "change_detected": {"type": "boolean"},
    "parser_version": {"type": "string", "minLength": 1},
    "parse_status": {"enum": ["SUCCESS", "PARTIAL", "FAILED"]},
    "parse_warnings": {"type": "array", "items": {"type": "string"}},
    "source_version_status": {"enum": ["CURRENT", "UPDATED", "REMOVED_AT_SOURCE", "UNKNOWN"]},
    "source_function": {"enum": ["OFFICIAL_DECISION", "PROCEDURAL_STATUS", "LEGAL_TEXT", "CONSOLIDATED_LAW", "MINISTRY_DRAFT", "IMPLEMENTATION_RULE", "BUDGET_DATA", "FUNDING_RULE", "MONITORING_DATA", "EVALUATION", "COMMUNICATION", "CONTEXT"]},
    "provenance": {"type": "object"}
  }
}


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parlament.wirkungsoekonomie.de/schemas/impact-visual-scenario-1.0.json",
  "title": "WÖk ImpactVisualScenario descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "manifest_sha256", "base_main_commit", "source_release", "generation_policy", "public_contract", "records"],
  "properties": {
    "schema_version": { "const": "woek-impact-visual-scenarios-1.0" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "base_main_commit": { "$ref": "#/$defs/commit" },
    "source_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "manifest_path", "descriptor_sha256", "published_commit"],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "manifest_path": { "type": "string", "minLength": 1 },
        "descriptor_sha256": { "$ref": "#/$defs/sha256" },
        "published_commit": { "$ref": "#/$defs/commit" }
      }
    },
    "generation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_mode", "raw_programme_text_allowed", "campaign_slogan_allowed", "party_valence_style", "fachdata_backpropagation_allowed", "automatic_generation_allowed"],
      "properties": {
        "input_mode": { "const": "APPROVED_VISUAL_BRIEF_ONLY" },
        "raw_programme_text_allowed": { "const": false },
        "campaign_slogan_allowed": { "const": false },
        "party_valence_style": { "const": "PORTAL_NEUTRAL" },
        "fachdata_backpropagation_allowed": { "const": false },
        "automatic_generation_allowed": { "const": false }
      }
    },
    "public_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "disclaimer", "image_is_evidence"],
      "properties": {
        "label": { "const": "Wirkungsbild" },
        "disclaimer": { "const": "Visualisiertes Wirkungsszenario auf Basis der WÖk-Analyse. Keine Prognose." },
        "image_is_evidence": { "const": false }
      }
    },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "visibleElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "impact_path_id", "effect_order", "state_change", "affected_group_or_system", "time_horizon", "direction", "evidence_level", "uncertainty", "depiction_status", "analysis_href", "marker_position"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "impact_path_id": { "type": "string", "minLength": 1 },
        "effect_order": { "type": "integer", "minimum": 1, "maximum": 3 },
        "state_change": { "type": "string", "minLength": 1 },
        "affected_group_or_system": { "type": "string", "minLength": 1 },
        "time_horizon": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["POSITIVE", "NEGATIVE", "AMBIVALENT", "OPEN"] },
        "evidence_level": { "enum": ["HIGH", "MEDIUM", "LOW", "NOT_ASSESSABLE"] },
        "uncertainty": { "type": "string", "minLength": 1 },
        "depiction_status": { "enum": ["DIRECTLY_VISIBLE", "SYMBOLIC_WITH_LABEL", "NOT_VISUALIZABLE"] },
        "analysis_href": { "type": "string", "pattern": "^/" },
        "marker_position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x_percent", "y_percent"],
          "properties": {
            "x_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "y_percent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "visualBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "content_sha256", "review_status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "review_status": { "const": "APPROVED" }
      }
    },
    "caseAnalysisBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_provenance", "selected_case_id", "canonical_record_path", "canonical_editorial_path", "decision_or_measure", "intended_change", "source_statement_refs", "affected_group_or_system", "mechanism", "potential_state_change", "key_finding", "impact_core_summary", "editorial_summary", "direction_rationale", "impact_direction", "evidence_level", "competence_and_system_boundary", "material_risks", "impact_orders", "time_horizon", "materiality", "uncertainty", "falsification_or_reality_check", "noncompensation", "marker_decision", "editorial_input_status"],
      "properties": {
        "approval_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approval_basis", "approval_authority", "review_mode", "human_individual_record_review_claimed"],
          "properties": {
            "approval_basis": { "const": "DELEGATED_WOEK_EDITORIAL_REVIEW_PROTOCOL_2026-08-26" },
            "approval_authority": { "const": "PROJECT_OWNER_DELEGATED_PROTOCOL" },
            "review_mode": { "const": "SOURCE_BOUND_OBJECT_LEVEL" },
            "human_individual_record_review_claimed": { "const": false }
          }
        },
        "selected_case_id": { "type": "string", "minLength": 1 },
        "canonical_record_path": { "type": "string", "minLength": 1 },
        "canonical_editorial_path": { "type": "string", "minLength": 1 },
        "decision_or_measure": { "type": "string", "minLength": 1 },
        "intended_change": { "type": "string", "minLength": 1 },
        "source_statement_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_key", "location", "source_text"],
            "properties": {
              "source_key": { "type": "string", "minLength": 1 },
              "location": {
                "type": "object",
                "additionalProperties": false,
                "required": ["page", "section"],
                "properties": {
                  "page": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "string", "minLength": 1 }] },
                  "section": { "type": ["string", "null"] }
                }
              },
              "source_text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "affected_group_or_system": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mechanism": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "potential_state_change": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "key_finding": { "type": "string", "minLength": 1 },
        "impact_core_summary": { "type": "string", "minLength": 1 },
        "editorial_summary": { "type": "string", "minLength": 1 },
        "direction_rationale": { "type": "string", "minLength": 1 },
        "impact_direction": { "enum": ["POSITIVE", "NEGATIVE", "AMBIVALENT", "OPEN"] },
        "evidence_level": { "enum": ["HIGH", "MEDIUM", "LOW", "NOT_ASSESSABLE"] },
        "competence_and_system_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["responsible_actors", "competence_note", "implementation_conditions"],
          "properties": {
            "responsible_actors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "competence_note": { "type": ["string", "null"] },
            "implementation_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "material_risks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["risk", "trigger_or_condition", "affected_groups_or_goods", "evidence_status"],
            "properties": {
              "risk": { "type": "string", "minLength": 1 },
              "trigger_or_condition": { "type": "string", "minLength": 1 },
              "affected_groups_or_goods": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "evidence_status": { "type": "string", "minLength": 1 }
            }
          }
        },
        "impact_orders": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_order", "second_order", "third_order", "status"],
          "properties": {
            "first_order": { "type": "string", "minLength": 1 },
            "second_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "third_order": { "type": "string", "minLength": 1 },
            "status": { "type": "string", "minLength": 1 }
          }
        },
        "time_horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["short_term", "medium_term", "long_term", "intergenerational_relevance"],
          "properties": {
            "short_term": { "type": "string", "minLength": 1 },
            "medium_term": { "type": "string", "minLength": 1 },
            "long_term": { "type": "string", "minLength": 1 },
            "intergenerational_relevance": { "type": "string", "minLength": 1 }
          }
        },
        "materiality": { "type": "string", "minLength": 1 },
        "uncertainty": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "falsification_or_reality_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline_required", "primary_indicator", "unit", "counterfactual_required", "earliest_review", "correction_trigger"],
          "properties": {
            "baseline_required": { "type": "string", "minLength": 1 },
            "primary_indicator": { "type": "string", "minLength": 1 },
            "unit": { "type": "string", "minLength": 1 },
            "counterfactual_required": { "type": ["string", "null"] },
            "earliest_review": { "type": "string", "minLength": 1 },
            "correction_trigger": { "type": "string", "minLength": 1 }
          }
        },
        "noncompensation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["concern", "rationale", "status"],
            "properties": {
              "concern": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 }
            }
          }
        },
        "marker_decision": { "enum": ["ALLOWED_IF_CANONICAL_PATH_BINDING_PASSES", "NULL_MARKER_APPROVED"] },
        "editorial_input_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved_case_selection", "reviewed_visual_brief", "alt_text_review", "editorial_brief_signoff", "image_asset", "final_image_signoff"],
          "properties": {
            "approved_case_selection": { "const": "APPROVED" },
            "reviewed_visual_brief": { "const": "APPROVED" },
            "alt_text_review": { "const": "APPROVED" },
            "editorial_brief_signoff": { "const": "APPROVED" },
            "image_asset": { "const": "NOT_YET_SUPPLIED" },
            "final_image_signoff": { "const": "PENDING_ASSET" }
          }
        }
      }
    },
    "generatorMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "model_version", "generated_at", "prompt_sha256"],
      "properties": {
        "generator": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "prompt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "assetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mime_type", "width", "height", "byte_size", "original_filename", "original_sha256", "optimization", "integrated_at"],
      "properties": {
        "mime_type": { "const": "image/webp" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "byte_size": { "type": "integer", "minimum": 1 },
        "original_filename": { "type": "string", "minLength": 1 },
        "original_sha256": { "$ref": "#/$defs/sha256" },
        "optimization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "full_composition_preserved", "metadata_published"],
          "properties": {
            "format": { "const": "WEBP_LOSSY_Q90" },
            "full_composition_preserved": { "const": true },
            "metadata_published": { "const": false }
          }
        },
        "integrated_at": { "type": "string", "format": "date" }
      }
    },
    "missingApprovedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description", "required_for"],
      "properties": {
        "code": { "enum": ["APPROVED_CASE_SELECTION", "REVIEWED_VISUAL_BRIEF", "VISIBLE_ELEMENT_MAPPING", "NON_VISUAL_EFFECT_SELECTION", "ALT_TEXT_REVIEW", "EDITORIAL_VISUAL_SIGNOFF", "IMAGE_ASSET", "FINAL_IMAGE_SIGNOFF"] },
        "description": { "type": "string", "minLength": 1 },
        "required_for": { "enum": ["PROGRAM_SCENARIO", "CASE_SCENARIO", "BOTH"] }
      }
    },
    "changeHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "status", "note"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "status": { "enum": ["FAIL_CLOSED_CREATED", "APPROVED", "CORRECTED", "SUPERSEDED"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object_type", "object_id", "source_key", "analysis_version", "knowledge_cutoff", "stage", "visual_scope", "title", "normalized_subject", "source_statement_refs", "selected_impact_path_ids", "eligible_approved_analysis_refs", "selection_rationale", "visible_elements", "case_analysis_binding", "non_visual_effects", "non_visual_effects_review_status", "omitted_material_effects", "omitted_marker_candidates", "system_boundary", "scenario_assumptions", "evidence_summary", "disclaimer", "asset_path", "alt_text", "visual_brief", "generator_metadata", "asset_sha256", "asset_metadata", "editorial_review_status", "source_fidelity_status", "missing_approved_inputs", "change_history"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "object_type": { "enum": ["PROGRAM", "COMMITMENT", "IMPACT_CASE", "GOVERNMENT_ACTION"] },
        "object_id": { "type": "string", "minLength": 1 },
        "source_key": { "type": "string", "minLength": 1 },
        "analysis_version": { "type": "string", "minLength": 1 },
        "knowledge_cutoff": { "type": "string", "format": "date" },
        "stage": { "enum": ["EX_ANTE", "EX_POST"] },
        "visual_scope": { "enum": ["PROGRAM_SCENARIO", "CASE_SCENARIO"] },
        "title": { "type": "string", "minLength": 1 },
        "normalized_subject": { "type": "string", "minLength": 1 },
        "source_statement_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "selected_impact_path_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "eligible_approved_analysis_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "selection_rationale": { "type": "string", "minLength": 1 },
        "visible_elements": { "type": "array", "items": { "$ref": "#/$defs/visibleElement" } },
        "case_analysis_binding": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/caseAnalysisBinding" }] },
        "non_visual_effects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "non_visual_effects_review_status": { "enum": ["PENDING_APPROVAL", "REVIEWED_COMPLETE"] },
        "omitted_material_effects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "omitted_marker_candidates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "system_boundary": { "type": ["string", "null"] },
        "scenario_assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence_summary": { "type": "string", "minLength": 1 },
        "disclaimer": { "const": "Visualisiertes Wirkungsszenario auf Basis der WÖk-Analyse. Keine Prognose." },
        "asset_path": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^/visuals/impact-scenarios/" }] },
        "alt_text": { "type": ["string", "null"] },
        "visual_brief": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/visualBrief" }] },
        "generator_metadata": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/generatorMetadata" }] },
        "asset_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "asset_metadata": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/assetMetadata" }] },
        "editorial_review_status": { "enum": ["NO_APPROVED_VISUAL_SCENARIO", "PREPARED_AWAITING_ASSET", "APPROVED_FOR_PUBLICATION"] },
        "source_fidelity_status": { "enum": ["FAIL_CLOSED_NO_PUBLIC_ASSET", "PASS_APPROVED_ANALYSIS_ONLY_AWAITING_ASSET", "PASS_APPROVED_ANALYSIS_ONLY"] },
        "missing_approved_inputs": { "type": "array", "items": { "$ref": "#/$defs/missingApprovedInput" } },
        "change_history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/changeHistoryEntry" } }
      }
    }
  }
}

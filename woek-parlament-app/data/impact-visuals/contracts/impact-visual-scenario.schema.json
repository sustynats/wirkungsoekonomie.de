{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parlament.wirkungsoekonomie.de/schemas/impact-visual-scenario-1.0.json",
  "title": "WÖk ImpactVisualScenario descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "manifest_sha256", "base_main_commit", "source_release", "generation_policy", "public_contract", "records"],
  "properties": {
    "schema_version": { "const": "woek-impact-visual-scenarios-1.0" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "base_main_commit": { "$ref": "#/$defs/commit" },
    "source_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "manifest_path", "descriptor_sha256", "published_commit"],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "manifest_path": { "type": "string", "minLength": 1 },
        "descriptor_sha256": { "$ref": "#/$defs/sha256" },
        "published_commit": { "$ref": "#/$defs/commit" }
      }
    },
    "generation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_mode", "raw_programme_text_allowed", "campaign_slogan_allowed", "party_valence_style", "fachdata_backpropagation_allowed", "automatic_generation_allowed"],
      "properties": {
        "input_mode": { "const": "APPROVED_VISUAL_BRIEF_ONLY" },
        "raw_programme_text_allowed": { "const": false },
        "campaign_slogan_allowed": { "const": false },
        "party_valence_style": { "const": "PORTAL_NEUTRAL" },
        "fachdata_backpropagation_allowed": { "const": false },
        "automatic_generation_allowed": { "const": false }
      }
    },
    "public_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "disclaimer", "image_is_evidence"],
      "properties": {
        "label": { "const": "Wirkungsbild" },
        "disclaimer": { "const": "Visualisiertes Wirkungsszenario auf Basis der WÖk-Analyse. Keine Prognose." },
        "image_is_evidence": { "const": false }
      }
    },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "visibleElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "impact_path_id", "effect_order", "state_change", "affected_group_or_system", "time_horizon", "direction", "evidence_level", "uncertainty", "depiction_status", "analysis_href", "marker_position"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "impact_path_id": { "type": "string", "minLength": 1 },
        "effect_order": { "type": "integer", "minimum": 1, "maximum": 3 },
        "state_change": { "type": "string", "minLength": 1 },
        "affected_group_or_system": { "type": "string", "minLength": 1 },
        "time_horizon": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["POSITIVE", "NEGATIVE", "AMBIVALENT", "OPEN"] },
        "evidence_level": { "enum": ["HIGH", "MEDIUM", "LOW", "NOT_ASSESSABLE"] },
        "uncertainty": { "type": "string", "minLength": 1 },
        "depiction_status": { "enum": ["DIRECTLY_VISIBLE", "SYMBOLIC_WITH_LABEL", "NOT_VISUALIZABLE"] },
        "analysis_href": { "type": "string", "pattern": "^/" },
        "marker_position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x_percent", "y_percent"],
          "properties": {
            "x_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "y_percent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "visualBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "content_sha256", "review_status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "review_status": { "const": "APPROVED" }
      }
    },
    "generatorMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "model_version", "generated_at", "prompt_sha256"],
      "properties": {
        "generator": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "prompt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "assetMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mime_type", "width", "height", "byte_size", "original_filename", "original_sha256", "optimization", "integrated_at"],
      "properties": {
        "mime_type": { "const": "image/webp" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "byte_size": { "type": "integer", "minimum": 1 },
        "original_filename": { "type": "string", "minLength": 1 },
        "original_sha256": { "$ref": "#/$defs/sha256" },
        "optimization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "full_composition_preserved", "metadata_published"],
          "properties": {
            "format": { "const": "WEBP_LOSSY_Q90" },
            "full_composition_preserved": { "const": true },
            "metadata_published": { "const": false }
          }
        },
        "integrated_at": { "type": "string", "format": "date" }
      }
    },
    "missingApprovedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description", "required_for"],
      "properties": {
        "code": { "enum": ["APPROVED_CASE_SELECTION", "REVIEWED_VISUAL_BRIEF", "VISIBLE_ELEMENT_MAPPING", "NON_VISUAL_EFFECT_SELECTION", "ALT_TEXT_REVIEW", "EDITORIAL_VISUAL_SIGNOFF"] },
        "description": { "type": "string", "minLength": 1 },
        "required_for": { "enum": ["PROGRAM_SCENARIO", "CASE_SCENARIO", "BOTH"] }
      }
    },
    "changeHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "status", "note"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "status": { "enum": ["FAIL_CLOSED_CREATED", "APPROVED", "CORRECTED", "SUPERSEDED"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object_type", "object_id", "source_key", "analysis_version", "knowledge_cutoff", "stage", "visual_scope", "title", "normalized_subject", "source_statement_refs", "selected_impact_path_ids", "eligible_approved_analysis_refs", "selection_rationale", "visible_elements", "non_visual_effects", "non_visual_effects_review_status", "omitted_material_effects", "omitted_marker_candidates", "system_boundary", "scenario_assumptions", "evidence_summary", "disclaimer", "asset_path", "alt_text", "visual_brief", "generator_metadata", "asset_sha256", "asset_metadata", "editorial_review_status", "source_fidelity_status", "missing_approved_inputs", "change_history"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "object_type": { "enum": ["PROGRAM", "COMMITMENT", "IMPACT_CASE", "GOVERNMENT_ACTION"] },
        "object_id": { "type": "string", "minLength": 1 },
        "source_key": { "type": "string", "minLength": 1 },
        "analysis_version": { "type": "string", "minLength": 1 },
        "knowledge_cutoff": { "type": "string", "format": "date" },
        "stage": { "enum": ["EX_ANTE", "EX_POST"] },
        "visual_scope": { "enum": ["PROGRAM_SCENARIO", "CASE_SCENARIO"] },
        "title": { "type": "string", "minLength": 1 },
        "normalized_subject": { "type": "string", "minLength": 1 },
        "source_statement_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "selected_impact_path_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "eligible_approved_analysis_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "selection_rationale": { "type": "string", "minLength": 1 },
        "visible_elements": { "type": "array", "items": { "$ref": "#/$defs/visibleElement" } },
        "non_visual_effects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "non_visual_effects_review_status": { "enum": ["PENDING_APPROVAL", "REVIEWED_COMPLETE"] },
        "omitted_material_effects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "omitted_marker_candidates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "system_boundary": { "type": ["string", "null"] },
        "scenario_assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence_summary": { "type": "string", "minLength": 1 },
        "disclaimer": { "const": "Visualisiertes Wirkungsszenario auf Basis der WÖk-Analyse. Keine Prognose." },
        "asset_path": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^/visuals/impact-scenarios/" }] },
        "alt_text": { "type": ["string", "null"] },
        "visual_brief": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/visualBrief" }] },
        "generator_metadata": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/generatorMetadata" }] },
        "asset_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "asset_metadata": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/assetMetadata" }] },
        "editorial_review_status": { "enum": ["NO_APPROVED_VISUAL_SCENARIO", "APPROVED_FOR_PUBLICATION"] },
        "source_fidelity_status": { "enum": ["FAIL_CLOSED_NO_PUBLIC_ASSET", "PASS_APPROVED_ANALYSIS_ONLY"] },
        "missing_approved_inputs": { "type": "array", "items": { "$ref": "#/$defs/missingApprovedInput" } },
        "change_history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/changeHistoryEntry" } }
      }
    }
  }
}

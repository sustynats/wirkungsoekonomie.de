  "source_objects": [
    {
      "object_id": "BE-SPD-2026-SU-0248",
      "source_page": 22,
      "source_locator": "p022:b004@42.52,157.55,222.96,169.52",
      "source_text": "Berlin bleibt eine Mieter*innen-Stadt.",
      "source_text_sha256": "8c1db47c430eeb7d75b6036d2e5b627a5fb76f2d98ff1fd87581e15d2d7fa24f",
      "source_object_kind": "SOURCE_UNIT"
    },
    {
      "object_id": "BE-SPD-2026-SU-0249",
      "source_page": 22,
      "source_locator": "p022:b005@304.73,69.84,539.26,147.82",
      "source_text": "Selbstgenutztes Wohneigentum unterstützen wir trotzdem gezielt - besonders für Familien mit geringem und niedrigem Einkommen im Rahmen von privaten Neubaugebieten sowie für Mieter*innen, die bei Umwandlung bereits in der Wohnung leben.",
      "source_text_sha256": "10a6fd8fc5d67cdb2b35ca28152c496b4eb9c511940cd93a8bea2489de417090",
      "source_object_kind": "SOURCE_UNIT"
    },
    {
      "object_id": "BE-SPD-2026-SU-0250",
      "source_page": 22,
      "source_locator": "p022:b006@42.52,185.86,403.63,203.86",
      "source_text": "Unser Berlin wird sauber, grün und lebenswert",
      "source_text_sha256": "95092915b5762d8d5fd222c87ca6dc2d262a0ffea434e8624481ba6344971ef3",
      "source_object_kind": "SOURCE_UNIT"
    },
    {
      "object_id": "BE-SPD-2026-SU-0251",
      "source_page": 22,
      "source_locator": "p022:b007@42.52,212.74,270.83,244.86",
      "source_text": "Feministische Stadtplanung: Berlin als faire, inklusive und sorgende Stadt",
      "source_text_sha256": "41e0efb8d505ac48c7d2afa72c2827b8ed8bae5ffa9639a54998215650d6ed1e",
      "source_object_kind": "SOURCE_UNIT"
    },
    {
      "object_id": "BE-SPD-2026-SU-0252-A01",
      "source_page": 22,
      "source_locator": "p022:b008@42.52,253.86,282.06,397.84",
      "source_text": "In der Stadtentwicklung orientieren wir uns an unterschiedlichen Lebensrealitäten",
      "source_text_sha256": "a8b1317617ef559000364e9994bfed41f038b66e2a8dba1982eef7fd73d8f061",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0252-A02",
      "source_page": 22,
      "source_locator": "p022:b008@42.52,253.86,282.06,397.84",
      "source_text": "und gestalten Berlin als Stadt für alle.",
      "source_text_sha256": "631cdf34d7893fc28d911bbfa7e71070dbd059fd582cfad7c0bad7dc82d3f98e",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0252-A03",
      "source_page": 22,
      "source_locator": "p022:b008@42.52,253.86,282.06,397.84",
      "source_text": "Bei Projekten werden wir Gender-Mainstreaming grundsätzlich als Standard für die Planung und Vergabe verankern, um Geschlechtergerechtigkeit aktiv umzusetzen.",
      "source_text_sha256": "2272caa5635bc6b7ed6e70e0c3fa3d835fd0da09ec53254a220d32c47f480e4b",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0252-A04",
      "source_page": 22,
      "source_locator": "p022:b008@42.52,253.86,282.06,397.84",
      "source_text": "Wir führen nach Vorbild der Stadt Wien eine eigene Leitstelle für „alltags- und gendergerechtes Planen",
      "source_text_sha256": "e9217bc44ad67911086325db667732d6e95168157b13c7c55d45a1a714b393b7",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0252-A05",
      "source_page": 22,
      "source_locator": "p022:b008@42.52,253.86,282.06,397.84",
      "source_text": "und Bauen“ ein",
      "source_text_sha256": "1f52f542de99f8fab36951975ec0e14644eeae0c36c8f0b21292fa63395ae7b0",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0252-A06",
      "source_page": 22,
      "source_locator": "p022:b008@42.52,253.86,282.06,397.84",
      "source_text": "und schaffen so eine institutionelle Verankerung.",
      "source_text_sha256": "6d348978e927abdbf857e708f978df5470ec65e387a45b1a87c3fbfdd3c33c0e",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0253",
      "source_page": 22,
      "source_locator": "p022:b009@42.52,408.55,233.48,440.67",
      "source_text": "Parks und Grünflächen schaffen Lebensqualität",
      "source_text_sha256": "cda97d29abb17417afc4ec796b4366649eccaae8ebff45a2b4a3e93d28af2616",
      "source_object_kind": "SOURCE_UNIT"
    },
    {
      "object_id": "BE-SPD-2026-SU-0254",
      "source_page": 22,
      "source_locator": "p022:b010@42.52,449.67,270.25,488.05",
      "source_text": "Parks und grüne urbane Flächen verbessern das Stadtklima, kühlen im Sommer und schaffen Lebensqualität für Mensch und Natur.",
      "source_text_sha256": "cb9aee6c13a08c96aec7a850a7ee23aff37100f5fd2b91c977d9bb858041dc1c",
      "source_object_kind": "SOURCE_UNIT"
    },
    {
      "object_id": "BE-SPD-2026-SU-0255-A01",
      "source_page": 22,
      "source_locator": "p022:b011@42.52,497.77,288.12,522.95",
      "source_text": "Wir versetzen die Bezirksämter dauerhaft finanziell und personell in die Lage, naturnah zu pflegen.",
      "source_text_sha256": "a54291020de72d9ee3635026aa57822805692efb4ec9c52b3212314dbe572cda",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0256-A01",
      "source_page": 22,
      "source_locator": "p022:b012@42.52,532.67,288.56,623.85",
      "source_text": "Parkläufer*innen sichern wir dauerhaft ab und weiten sie auf weitere Parks aus.",
      "source_text_sha256": "78bd4222679e0ccb3c7f375fd35bd01eb003416dc982f6bade8c9e1c3c51a812",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0257-A01",
      "source_page": 22,
      "source_locator": "p022:b013@42.52,633.58,285.79,698.35",
      "source_text": "Deshalb schaffen wir einen neuen Berliner Volkspark dort, wo besonders viel neuer Wohnraum entsteht - im Osten der Stadt.",
      "source_text_sha256": "c3b351895e3b20fcf89cb600c882c0f7e886f9013202aae047a9a11503a85db6",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0258",
      "source_page": 22,
      "source_locator": "p022:b014@42.52,709.07,208.74,724.39",
      "source_text": "Mehr Stadtbäume für Berlin",
      "source_text_sha256": "709124eb06bd224022e1d4013d352efdea3410395ac14bfad62a31796b40849a",
      "source_object_kind": "SOURCE_UNIT"
    },
    {
      "object_id": "BE-SPD-2026-SU-0259-A01",
      "source_page": 22,
      "source_locator": "p022:b015@42.52,733.39,275.72,771.77;p022:b016@304.73,211.76,542.69,276.53",
      "source_text": "Bis 2040 soll die Zahl der Stadtbäume um 70 Prozent steigen.",
      "source_text_sha256": "e1713effbdbc29c4fd82a2139c4a1a6dbc890e64f0ef28cd8397ab815139731c",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0260-A01",
      "source_page": 22,
      "source_locator": "p022:b017@304.73,286.26,548.62,403.84",
      "source_text": "Altbäume mit ihrer Schattenwirkung schützen wir stärker",
      "source_text_sha256": "748caa96eb074e65951f2036fa2baa5e175bc0b093716270d207abc0fc98c64f",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0260-A02",
      "source_page": 22,
      "source_locator": "p022:b017@304.73,286.26,548.62,403.84",
      "source_text": "und verbessern die Pflege des Bestands.",
      "source_text_sha256": "35fd4372efac0e839f1b01ef085b13e2343d73b67fe3fc7ea787a837e26c0a18",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0260-A03",
      "source_page": 22,
      "source_locator": "p022:b017@304.73,286.26,548.62,403.84",
      "source_text": "Im Hoch- und Tiefbau planen wir baumgerecht",
      "source_text_sha256": "5fd71ddaac8d224814c489e7d6c72d91f6d2ad2472681f18a4150346ce715934",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0260-A04",
      "source_page": 22,
      "source_locator": "p022:b017@304.73,286.26,548.62,403.84",
      "source_text": "und koppeln Fällgenehmigungen an den tatsächlichen Baubeginn.",
      "source_text_sha256": "4ba53805211f1ee81f9cbed83878bbf7c6d614789baf69196177ce382e4f0799",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0260-A05",
      "source_page": 22,
      "source_locator": "p022:b017@304.73,286.26,548.62,403.84",
      "source_text": "Bei Baumaßnahmen werden wir baumerhaltende Planungen grundsätzlich priorisieren.",
      "source_text_sha256": "1e1bd020e3e0f642b015b672fb416128c84940ac0e65746acf7919eb3bc57b39",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0260-A06",
      "source_page": 22,
      "source_locator": "p022:b017@304.73,286.26,548.62,403.84",
      "source_text": "Auch dafür passen wir die Regeln für den Straßenraum an Klimaschutz und Baumschutz an.",
      "source_text_sha256": "0c33bd8ee679936e97004f07c30108708886c70479f9740a530def2870dfbef4",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0261-A01",
      "source_page": 22,
      "source_locator": "p022:b018@304.73,413.56,539.62,491.54",
      "source_text": "Wir erhalten Straßenbaumstandorte, bepflanzen leere Baumscheiben bis 2027",
      "source_text_sha256": "a1b5b5a47a3423973f56fedcdf18f3715fde5626d2733cf01c3476966d34fd09",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0261-A02",
      "source_page": 22,
      "source_locator": "p022:b018@304.73,413.56,539.62,491.54",
      "source_text": "und schaffen neue Baumstandorte - im Zielbild alle 15 Meter einen.",
      "source_text_sha256": "2310f7b9e6e8ac2df0f3f69814488ca2ff0d080c9fce938c079b44af861e735e",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0261-A03",
      "source_page": 22,
      "source_locator": "p022:b018@304.73,413.56,539.62,491.54",
      "source_text": "Dazu stärken wir die Stadtbaumkampagne und Baumpatenschaften",
      "source_text_sha256": "dd99590c7266ce2db419a59e631ea52f969f426e2af761bd032a41bcee3ca03d",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0261-A04",
      "source_page": 22,
      "source_locator": "p022:b018@304.73,413.56,539.62,491.54",
      "source_text": "und aktivieren bürgerschaftliches Engagement.",
      "source_text_sha256": "6281956f1a7af6f86f6b40bd4fe5a01f53ca22fad9ec331b42919173a042a683",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0262",
      "source_page": 22,
      "source_locator": "p022:b019@304.72,502.26,534.00,534.37",
      "source_text": "Abkühlung und grüne Erholung in den Kiezen",
      "source_text_sha256": "1dc490cb6887167e90e239338b4d566cf0415be09c023dd11ac6c95bc497e10e",
      "source_object_kind": "SOURCE_UNIT"
    },
    {
      "object_id": "BE-SPD-2026-SU-0263-A01",
      "source_page": 22,
      "source_locator": "p022:b020@304.72,543.37,554.11,621.35",
      "source_text": "Wir gestalten Plätze und Straßen so, dass Menschen dort gern verweilen und sich sicher fühlen - und dass zugleich Lebensräume für Stadtnatur und Tiere entstehen.",
      "source_text_sha256": "e91534f02e4b2e27a088ac15efd6d06e86a07c721bd1b1aefa25163508be6854",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0264-A01",
      "source_page": 22,
      "source_locator": "p022:b021@304.72,631.07,505.98,682.65",
      "source_text": "Den Zugang zu Wasser verbessern wir mit Planschen und Brunnen, die die Berliner Wasserbetriebe zentral ausbauen und instandhalten.",
      "source_text_sha256": "a41fc41da938a8530bb4cc11f42f2b0a0e63358976d7d909aa994680ec5e3d2a",
      "source_object_kind": "SOURCE_ATOM"
    },
    {
      "object_id": "BE-SPD-2026-SU-0265",
      "source_page": 22,
      "source_locator": "p022:b022@304.72,692.38,555.17,770.36",
      "source_text": "Wir handeln zuerst dort, wo Hitze, Lärm, Luftbelastung, Grünmangel und soziale Belastungen zusammenkommen. Hotspots wie den Washingtonplatz und den Vorplatz am Bahnhof Gesundbrunnen entsiegeln oder begrünen wir, etwa mit einem Tiny Forest.",
      "source_text_sha256": "d34e452e5f6a5dbb4dc2f9878aac0bafc242063dcb5670abb31c1fdc50a252a8",
      "source_object_kind": "SOURCE_UNIT"
    }
  ],

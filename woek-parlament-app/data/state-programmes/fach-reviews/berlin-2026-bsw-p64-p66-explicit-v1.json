  "source_objects": [
    {
      "object_id": "BE-BSW-P64-U01-16248ee5ead4",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 64,
      "source_text_sha256": "16248ee5ead4c4f3cd04b69e9ba8c7f3b9da1af989df30288d0343978ba3a487",
      "source_text": "Digitalisierung, die wirklich nützt"
    },
    {
      "object_id": "BE-BSW-P64-U02-f238a2e3dcf4",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 64,
      "source_text_sha256": "f238a2e3dcf4787c0d061b21b3c9b6d106f7d975dc14b269e2b1ba17649c58a5",
      "source_text": "Digitale Souveränität und Unabhängigkeit"
    },
    {
      "object_id": "BE-BSW-P64-U04-d764b1f4336f",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 64,
      "source_text_sha256": "d764b1f4336f527b5ed4e46e2284c69188f51502da4c183797a5a40e8a832a7b",
      "source_text": "Schutz der Privatsphäre und sichere Kommunikation"
    },
    {
      "object_id": "BE-BSW-P64-U06-0317253c025f",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 64,
      "source_text_sha256": "0317253c025fb1288e913003466c50c2a40734d1f0d4a3181b325ab92e28a545",
      "source_text": "Transparenz und freier Zugang zu Wissen"
    },
    {
      "object_id": "BE-BSW-P64-U08-5e95584016f1",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 64,
      "source_text_sha256": "5e95584016f1fc09a77493522262d5e4924788d04167bd315e469c6cdac1cbe5",
      "source_text": "Technik, die bleibt - Recht auf Reparatur"
    },
    {
      "object_id": "BE-BSW-P64-U10-8b774263a676",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 64,
      "source_text_sha256": "8b774263a6762873e7a4c12cddad67ba699d65f732c3b1647d8d22d3b7bf9515",
      "source_text": "Keine Ausgrenzung durch Digitalisierung"
    },
    {
      "object_id": "BE-BSW-P64-U12-98633ed5097a",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 64,
      "source_text_sha256": "98633ed5097aedcfdf26df8666f60c620042d5d7da68c6577afe86d5cb445209",
      "source_text": "Demokratie und freier Zugang zu Informationen"
    },
    {
      "object_id": "BE-BSW-P65-U03-7838c60433d5",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 65,
      "source_text_sha256": "7838c60433d5b545c80c0bbd876ac0b8af607292b50cb48aec94bb0ac19ff180",
      "source_text": "Chancen und Verantwortung bei Künstlicher Intelligenz"
    },
    {
      "object_id": "BE-BSW-P65-U05-6ca9d9ff0c75",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 65,
      "source_text_sha256": "6ca9d9ff0c75df842465bea51992363dcf77a3c05c5bf5dda1a33cb87419a6b5",
      "source_text": "Umweltbewusste Digitalisierung"
    },
    {
      "object_id": "BE-BSW-P65-U07-244fe10173c7",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 65,
      "source_text_sha256": "244fe10173c771fde4e8ffc18c8852e785ec79680788716d2ec109abce550557",
      "source_text": "Wirtschaftliche Chancen durch Datensouveränität"
    },
    {
      "object_id": "BE-BSW-P65-U09-8ce2c5fad26d",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 65,
      "source_text_sha256": "8ce2c5fad26d0052acb1419186b0d3cb5edc39c453abf1fcad1a4e190d40cdc3",
      "source_text": "Gemeinwohl statt Profitlogik"
    },
    {
      "object_id": "BE-BSW-P65-U11-08c0b7804db8",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 65,
      "source_text_sha256": "08c0b7804db8e1b5630c01353f030065ee6f22d0a6a424ab62cb4ab78cc53ae8",
      "source_text": "IT-Kompetenz in der Verwaltung"
    },
    {
      "object_id": "BE-BSW-P66-U02-e22e98dadab5",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 66,
      "source_text_sha256": "e22e98dadab5b9380265d753e362be917282307441e64204f0a4050712844da0",
      "source_text": "Das BSW unterstützt:"
    },
    {
      "object_id": "BE-BSW-P66-U09-865953508ba9",
      "object_kind": "SOURCE_UNIT",
      "pdf_page": 66,
      "source_text_sha256": "865953508ba94b9c99cdfce3e64dd48c7d4408caaa560fa83d6bf8402d60b9fa",
      "source_excerpt": "Liebe Berlinerin, lieber Berliner, Deutschland soll schon bald 225 Milliarden Euro pro Jahr für Aufrüstung ausgeben, um das NATO-Ziel von 5% der Wirtschaftsleistung für den Rüstungshaushalt (d.h. nahezu die Hälfte des Bundeshaushaltes) zu …"
    },
    {
      "object_id": "BE-BSW-P64-U03-A01-e31aafd557af",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "e31aafd557af0d2db42bcc2579a298958515e07c79feadf01156b755f445f23a",
      "source_text": "Wir gestalten eine digitale Zukunft für die Menschen und für die Stärkung der Berliner Wirtschaft."
    },
    {
      "object_id": "BE-BSW-P64-U03-A02-d744b0f0c7bd",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "d744b0f0c7bd9662c34d0222bf16441bb8a349777b9f3cd2a1fb7007725f6c37",
      "source_text": "Der Staat soll seine technische Unabhängigkeit durch den Einsatz von offenen und standardisierten Schnittstellen und Formaten und freier und offener Software (FOSS - Free Open Source Software) zurückgewinnen."
    },
    {
      "object_id": "BE-BSW-P64-U03-A03-8e5159c9ff28",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "8e5159c9ff28fa7589c5e717b05b6c7d87d476ee09032d987a0ed4e382ebc097",
      "source_text": "Offene Systeme ermöglichen nicht nur Selbstbestimmung und Transparenz, sondern auch fairen Wettbewerb und mehr Innovationen."
    },
    {
      "object_id": "BE-BSW-P64-U03-A04-e81644f6ffe2",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "e81644f6ffe289c500b14d5f2143669d7babf8fc25e5e366520aec80e2d1a035",
      "source_text": "Öffentliche Mittel fließen in Systeme, deren Quellcode offen ist, damit Verwaltung und Bürger gemeinsam vom Fortschritt profitieren."
    },
    {
      "object_id": "BE-BSW-P64-U05-A01-76911b5d4f09",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "76911b5d4f098bf1ad3e798e5b3fa869fef94c3eeb96caa068c2044950c8c1dd",
      "source_text": "Datenschutz und Datensicherheit sind Grundrechte und gleichzeitig wirtschaftliche Chancen."
    },
    {
      "object_id": "BE-BSW-P64-U05-A02-f0ef4de552f8",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "f0ef4de552f88c7bc1bbfabc08954e956c76b9e8c4594ed89903f2c46b5948e7",
      "source_text": "Unternehmen, die Daten verantwortungsvoll schützen und verschlüsseln, gewinnen Vertrauen und können innovative Produkte entwickeln."
    },
    {
      "object_id": "BE-BSW-P64-U05-A03-26464f3bea35",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "26464f3bea35c588accb899a333275ad4bb71e7d2e3fa9f2720ea7b2482bd7f2",
      "source_text": "Wir fördern starke Verschlüsselung, gemeinfreie Forschung und transparente Systeme, die Bürger und Wirtschaft gleichermaßen stärken."
    },
    {
      "object_id": "BE-BSW-P64-U05-A04-8c8851239a50",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "8c8851239a50f9bc6c26c54f0084a14a43f1445f613b56459b0a79bf14bde386",
      "source_text": "Überwachung ohne Anlass lehnen wir ab - Freiheit und Sicherheit gehören zusammen."
    },
    {
      "object_id": "BE-BSW-P64-U07-A01-dc69a247dbaa",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "dc69a247dbaa2d74083458d2aa4416e167694b388f68bdea5019f1bdc3c154fd",
      "source_text": "Daten aus öffentlicher Hand müssen allen zugutekommen."
    },
    {
      "object_id": "BE-BSW-P64-U07-A02-b593e7fe130d",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "b593e7fe130d367787d6598f93a8c45563027a1fb46b45b4a83edffde6b7b0b4",
      "source_text": "Mit Open Data schaffen wir Transparenz, fördern Forschung und unternehmerische Innovation."
    },
    {
      "object_id": "BE-BSW-P64-U07-A03-ebb364e654d0",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "ebb364e654d038ca9118ee35358294ded2c46bc75a4966a9eef7d9d22d4fb231",
      "source_text": "Unternehmen können auf standardisierte, offene Daten zurückgreifen, um neue Dienstleistungen zu entwickeln, während Bürgerinnen und Bürger informiert und souverän bleiben."
    },
    {
      "object_id": "BE-BSW-P64-U07-A04-ca0e0f167505",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "ca0e0f167505653c8745db2907b61b873f3c5b3449df572bffadbf1032c61abb",
      "source_text": "Öffentliche Förderung digitaler Infrastruktur unterstützen wir nur, wenn der Zugang offen für alle ist - so entstehen Wettbewerb und Teilhabe zugleich."
    },
    {
      "object_id": "BE-BSW-P64-U09-A01-29de93aec54e",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "29de93aec54eb06e5ed805405f355bde96f738d4c80619ecc39465ef2f2d4121",
      "source_text": "Nachhaltigkeit, Reparierbarkeit und Kontrolle über Technologie sind entscheidend für Bürger und Wirtschaft."
    },
    {
      "object_id": "BE-BSW-P64-U09-A02-e7dc6a8e11bf",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "e7dc6a8e11bf4b28d89cef669ff6d403b6b0038dc7f93240d92a2f8d80f153f9",
      "source_text": "Geräte sollen auch nach dem Support-Ende weiter nutzbar sein, um Elektroschrott zu vermeiden."
    },
    {
      "object_id": "BE-BSW-P64-U09-A03-57cf2aa45d44",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "57cf2aa45d441db25a86b9003b36d7b28b9bf33453a6b70ae9e12ae377362c6e",
      "source_text": "Herstellerinformationen, Sicherheitsupdates und offene Systeme fördern innovative Geschäftsmodelle rund um Wartung und Reparatur."
    },
    {
      "object_id": "BE-BSW-P64-U09-A04-d5704ee883d2",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "d5704ee883d23e016f568ed030d8ef6a18b7292f04ba0cef480174a6d87fa5d3",
      "source_text": "Öffentliche Mittel fließen in Systeme, die langfristig sicher, wartbar und wirtschaftlich effizient sind."
    },
    {
      "object_id": "BE-BSW-P64-U11-A01-89debb18e46f",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "89debb18e46f4629e4fb7954d31253a93f53075975cded50bd4936d5f635faee",
      "source_text": "Digitalisierung muss inklusiv und fair sein."
    },
    {
      "object_id": "BE-BSW-P64-U11-A02-10b0d0d82062",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "10b0d0d820627cc2664e4b601c7979fe1b512c2f929a82d8640074e14642151b",
      "source_text": "Wer kein Smartphone oder keinen Computer besitzt, muss mitgenommen werden."
    },
    {
      "object_id": "BE-BSW-P64-U11-A03-14594f79efbb",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "14594f79efbb51ace80d9a2338eda1d901430fc0ed870d5fabf80d3712c9314f",
      "source_text": "Über Bürgerämter und Bürgerdienste sollen gezielt Möglichkeiten geschaffen werden, Menschen ohne Zugang zu Smartphone oder Computer an der digitalen Welt zu beteiligen."
    },
    {
      "object_id": "BE-BSW-P64-U11-A04-a1e38ecd1237",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "a1e38ecd123716fdc6cb9390e6467b55327f5ebedfe53edbaf5a694a5425893a",
      "source_text": "Analoge Angebote müssen gleichwertig zugänglich bleiben."
    },
    {
      "object_id": "BE-BSW-P64-U11-A05-fda2d8b7608b",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 64,
      "source_text_sha256": "fda2d8b7608beaf81d30e60c7ad72953870684fab5f7829119fdfba49c9226f5",
      "source_text": "Dies sichert nicht nur Bürgerrechte, sondern schafft faire Rahmenbedingungen für Unternehmen, die Dienstleistungen sowohl digital als auch analog anbieten."
    },
    {
      "object_id": "BE-BSW-P65-U01-A01-a89e509447db",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "a89e509447db04c50cbe1ed05b4b1b6c487502e2046ac8268c01cdc8422b7efe",
      "source_text": "Ein freier Zugang zu Informationen stärkt Demokratie und Wirtschaft gleichermaßen."
    },
    {
      "object_id": "BE-BSW-P65-U01-A02-9833c4fb3406",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "9833c4fb34069c96270495b73de8b47cb3b9f5fa027e532a89af6134243bb9f5",
      "source_text": "Bürgerinnen und Bürger sollen selbstständig entscheiden, welche Quellen sie nutzen."
    },
    {
      "object_id": "BE-BSW-P65-U01-A03-7601f45a1b70",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "7601f45a1b7092ae280c4ae4c1ac6e6674a01233bfe2a270b0015e7ea2f2015d",
      "source_text": "Offene Netze und transparente Inhalte fördern Vertrauen, Innovationskraft und ermöglichen Unternehmen, neue Ideen auf solider Grundlage zu entwickeln."
    },
    {
      "object_id": "BE-BSW-P65-U01-A04-1d6eb01cd71a",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "1d6eb01cd71a0895f55473c04d6a389bcc20d1da51329dbb33028c426760a727",
      "source_text": "Zensur, Upload-Filter und pauschale Blockaden widersprechen diesen Prinzipien."
    },
    {
      "object_id": "BE-BSW-P65-U02-A01-2bcd14dd17b3",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "2bcd14dd17b3468c21ba2872d337b8ebe81ccdd17f6ff0edbaa36332a519ff6d",
      "source_text": "Der Schutz der Privatsphäre im ÖPNV ist ein zentrales Recht unserer Bürger."
    },
    {
      "object_id": "BE-BSW-P65-U02-A02-07cf4032f4e4",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "07cf4032f4e4a84d4f68f7107b6df8684b63d158a159517260693bca41004340",
      "source_excerpt": "Die derzeitige Praxis, dass Transferleistungsbeziehende bei einer Ticketkontrolle zusätzlich zu ihrem Sozialticket ihre Jobcenterbescheide nebst ihrer Personalausweise vorzeigen müssen, widerspricht dem Recht auf informationelle Selbstbest…"
    },
    {
      "object_id": "BE-BSW-P65-U02-A03-75ba79c0ebd1",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "75ba79c0ebd1e9f44f72f1a7b713debcf7979c986b09c2442c1c95193e8030a8",
      "source_excerpt": "Die Abschaffung des Berlinpasses und die damit verbundene Notwendigkeit, Jobcenter- oder Sozialbescheide in öffentlichen Verkehrsmitteln vorzuzeigen, führt dazu, dass Menschen im öffentlichen Raum gezwungen werden, ihren Sozialstatus bloßz…"
    },
    {
      "object_id": "BE-BSW-P65-U04-A01-f854ce389b5c",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "f854ce389b5c868626dda436bea9f6d4c725b758c8a7ea56fe8ee4209e3f5f80",
      "source_text": "KI kann Prozesse vereinfachen, Wissen nutzbar machen und wirtschaftliche Potenziale freisetzen."
    },
    {
      "object_id": "BE-BSW-P65-U04-A02-7cea8c1ba699",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "7cea8c1ba6997659040c21e6fca828b7e58c38845667675033586579c5ce2f4d",
      "source_text": "Wir fördern KI unter klaren Regeln: transparent, nachvollziehbar und fair."
    },
    {
      "object_id": "BE-BSW-P65-U04-A03-450d3ece0004",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "450d3ece00041c3e08acf6fb080611d61a9dbf743009d4585ac52d362d228e7c",
      "source_text": "Entscheidungen automatisierter Systeme (ADMT - Automated Decision-Making Technologies) müssen überprüfbar sein, Bürger dürfen nicht benachteiligt werden."
    },
    {
      "object_id": "BE-BSW-P65-U04-A04-86f3e6fcc165",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "86f3e6fcc165fb54d165221f12b281f5a71fa34e3a0ae05e8a721e6dbd23790c",
      "source_text": "So entstehen innovative, datenschutzfreundliche Geschäftsmodelle, die Menschen und Wirtschaft gleichermaßen nutzen."
    },
    {
      "object_id": "BE-BSW-P65-U06-A01-2f940987a765",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "2f940987a7656adb1b2e684bbf48e065940b5a6d364ba1410a9d50e584736594",
      "source_text": "Digitalisierung soll Effizienz und Nachhaltigkeit verbinden."
    },
    {
      "object_id": "BE-BSW-P65-U06-A02-b9db2867dba1",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "b9db2867dba1c9c656f14b72e30396407153f0fc6229b6c3e9b4c38a4582abbc",
      "source_text": "Energieverbrauch und Strahlungsbelastung werden minimiert, öffentliche Systeme und Geräte umweltbewusst betrieben und Elektroschrott verhindert."
    },
    {
      "object_id": "BE-BSW-P65-U06-A03-03f8eeecdcce",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "03f8eeecdcce105082c00f1d92ed43a2cc53efaf295ceb221bb450f449173339",
      "source_text": "Effiziente Technik senkt Kosten, fördert Wettbewerbsfähigkeit und schützt gleichzeitig Umwelt und Ressourcen - ein Gewinn für Bürger, Unternehmen und Natur."
    },
    {
      "object_id": "BE-BSW-P65-U08-A01-0bcd18fc66c5",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "0bcd18fc66c584814bb341abc793e89b07750d68234f2337cdf263323a09a668",
      "source_text": "Datenschutz, offene Standards und Kontrolle über Daten sind Wettbewerbsvorteile."
    },
    {
      "object_id": "BE-BSW-P65-U08-A02-4a1acc063580",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "4a1acc063580178dff8c5624f6c0d826ec046cd0679f3e61e98bcb84381d0658",
      "source_text": "Unternehmen, die verantwortungsvoll mit Daten umgehen, schaffen Vertrauen und Innovation."
    },
    {
      "object_id": "BE-BSW-P65-U08-A03-9a62b902525c",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "9a62b902525c8f7bb8ca201e867fe0af01b9b91c66fd7554e07dfe91f857b5a8",
      "source_text": "Staatliche Rahmenbedingungen sollen Sicherheit, Offenheit und Fairness verbinden, sodass Start-ups, Mittelstand und große Unternehmen gleichermaßen profitieren."
    },
    {
      "object_id": "BE-BSW-P65-U10-A01-5868531f0dcd",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "5868531f0dcd15a0760d477fd90d5b7075d571788ac211935c407e146b14947c",
      "source_text": "Digitalisierung soll dem Gemeinwohl dienen, Innovationen fördern und wirtschaftliche Chancen nutzen."
    },
    {
      "object_id": "BE-BSW-P65-U10-A02-aac9909a2907",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "aac9909a2907002385e9a455a240d6b7b0273933dc47e2bdc7fecbd028cd4914",
      "source_text": "Staatliche Mittel schaffen Rahmenbedingungen für faire Märkte, Transparenz und nachhaltige Teilhabe."
    },
    {
      "object_id": "BE-BSW-P65-U10-A03-f958fa007bf0",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 65,
      "source_text_sha256": "f958fa007bf0e54a61b4874e54797ba9bd545e187ec4eead311f91e3639be89e",
      "source_text": "Wir setzen auf eine menschliche, souveräne und wirtschaftlich zukunftsfähige Digitalisierung, die Freiheit, Verantwortung und Innovation für alle verbindet."
    },
    {
      "object_id": "BE-BSW-P66-U01-A01-f3ddea2b02c2",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 66,
      "source_text_sha256": "f3ddea2b02c23bbebcce0ab41d9a010b0f5cc6fc58ca8f0a48fcd0ce46b56ba1",
      "source_excerpt": "Um für eine erfolgreiche Umsetzung der Verwaltungsdigitalisierung exzellente EDV- Mitarbeiter gewinnen zu können, sollen die derzeitigen Eingruppierungskriterien gelockert werden, damit auch im öffentlichen Dienst konkurrenzfähige Gehälter…"
    },
    {
      "object_id": "BE-BSW-P66-U03-A01-54d8796721c2",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 66,
      "source_text_sha256": "54d8796721c26e2c17139f7afefd826e563c998364c90c258f986867f5455f6d",
      "source_text": "Um den Verkehrsfluss zu optimieren, will das BSW ein Pilotprojekt unter Einsatz digitaler Technologien oder künstlicher Intelligenz zur Steuerung der Verkehrsampeln in der Stadt einführen."
    },
    {
      "object_id": "BE-BSW-P66-U04-A01-1f93125a3d8e",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 66,
      "source_text_sha256": "1f93125a3d8edca26d31ce92078b194f7c481ff14f327bc35c92ece50a48cfab",
      "source_text": "Das Baustellen-Management der Stadt soll mithilfe digitaler Technologien oder künstlicher Intelligenz effizienter gestaltet werden, um einen besseren Verkehrsfluss zu ermöglichen."
    },
    {
      "object_id": "BE-BSW-P66-U05-A01-d33670e9d257",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 66,
      "source_text_sha256": "d33670e9d257383f88580b7ffd7b016deaac62237d6ebdb41b37899ea5c3f518",
      "source_text": "Ein Pilotprojekt in Zusammenarbeit mit der BVG und unter Einsatz von künstlicher Intelligenz zum bedarfsgerechten Einsatz von Bussen soll geschaffen werden."
    },
    {
      "object_id": "BE-BSW-P66-U06-A01-3e80da64cbb4",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 66,
      "source_text_sha256": "3e80da64cbb48b5aa0372eadf035563f1183bb4c7f7b753f6343876efed4e246",
      "source_text": "Das BSW initiiert eine Bundesratsinitiative für die Präzisierung des Hacker-Paragraphen 202c StGB, um eine Entkriminalisierung von nützlichen Hinweisgebern zu ermöglichen."
    },
    {
      "object_id": "BE-BSW-P66-U07-A01-e77ec060a053",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 66,
      "source_text_sha256": "e77ec060a053c1a0d1888827a8a84ea93ff4c897acac85382b964be727862272",
      "source_text": "Das BSW initiiert zudem eine Bundesratsinitiative für ein staatliches Gütesiegel für Ergebnisse menschlich kreativer Arbeit."
    },
    {
      "object_id": "BE-BSW-P66-U08-A01-856d33cfc15e",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 66,
      "source_text_sha256": "856d33cfc15eb231db046f23037b828c6b6f098a90c3bdf4d561e98fc6692e9a",
      "source_text": "Da Digitalisierung oft mit hohen Kosten verbunden ist, schlagen wir ein Pilotprojekt an einem Berliner Gericht vor, inspiriert vom Verwaltungsgericht Wien."
    },
    {
      "object_id": "BE-BSW-P66-U08-A02-64a6149d0f69",
      "object_kind": "SOURCE_ATOM",
      "pdf_page": 66,
      "source_text_sha256": "64a6149d0f69ae5c278b5b103f8e4d20380c07090db111c892c80f5a6bf7debc",
      "source_text": "Dort sind seit Jahren alle Eingaben in Schriftform auch per einfacher E-Mail möglich, ohne dass es bisher zu Manipulationsversuchen gekommen ist."
    }
  ],

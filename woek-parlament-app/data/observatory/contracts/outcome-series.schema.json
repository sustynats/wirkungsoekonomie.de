{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/outcome-series-1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome_series_id", "indicator_id", "definition", "unit", "geography", "source_refs", "observation_ids", "status"],
  "properties": {
    "outcome_series_id": { "type": "string" },
    "indicator_id": { "type": "string" },
    "definition": { "type": "string" },
    "unit": { "type": "string" },
    "geography": { "type": "string" },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
    "observation_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["ACTIVE", "STALE", "BLOCKED", "HISTORICAL"] }
  }
}

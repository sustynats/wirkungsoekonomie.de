{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/external-shock-1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["external_shock_id", "shock_type", "title", "observation_date", "geography", "source_refs", "attribution_status", "object_type"],
  "properties": {
    "external_shock_id": { "type": "string" },
    "shock_type": { "enum": ["DROUGHT", "HEATWAVE", "LOW_WATER", "FLOOD", "WILDFIRE", "ENERGY_SUPPLY", "GRID_FAILURE", "INFRASTRUCTURE_FAILURE", "HEALTH_EMERGENCY", "PRODUCTION_OR_TRANSPORT", "OTHER"] },
    "title": { "type": "string" },
    "observation_date": { "type": "string", "format": "date" },
    "geography": { "type": "array", "items": { "type": "string" } },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
    "attribution_status": { "enum": ["EXTERNAL_CONTEXT", "NO_ATTRIBUTION", "OPEN"] },
    "object_type": { "const": "EXTERNAL_SHOCK" }
  }
}

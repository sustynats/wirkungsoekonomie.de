{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/political-jurisdiction-1.0.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["jurisdiction_id", "jurisdiction_type", "name", "active_term_id", "lifecycle_state", "next_election_date", "monitoring_enabled"],
  "properties": {
    "jurisdiction_id": { "type": "string", "minLength": 2 },
    "jurisdiction_type": { "enum": ["FEDERAL", "STATE", "EU"] },
    "name": { "type": "string", "minLength": 2 },
    "active_term_id": { "type": "string", "minLength": 2 },
    "lifecycle_state": { "enum": ["DORMANT", "PRE_ELECTION_WATCH", "PROGRAMME_ANALYSIS", "ELECTION_RESULT", "COALITION_FORMATION", "GOVERNMENT_FORMED", "GOVERNMENT_MONITORING", "TRANSITION_TO_NEXT_TERM"] },
    "next_election_date": { "type": ["string", "null"], "format": "date" },
    "monitoring_enabled": { "type": "boolean" }
  }
}

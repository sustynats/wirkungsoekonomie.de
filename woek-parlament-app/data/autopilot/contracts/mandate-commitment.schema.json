{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/mandate-commitment-1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["mandate_commitment_id", "mandate_document_id", "source_locator", "commitment_text", "problem_assumption", "instrument", "competence_scope", "status", "election_commitment_relations"],
  "properties": {
    "mandate_commitment_id": { "type": "string", "minLength": 3 },
    "mandate_document_id": { "type": "string", "minLength": 3 },
    "source_locator": { "type": "string", "minLength": 1 },
    "commitment_text": { "type": "string", "minLength": 1 },
    "problem_assumption": { "type": ["string", "null"] },
    "instrument": { "type": ["string", "null"] },
    "competence_scope": { "enum": ["FEDERAL", "LAND_FULL", "LAND_PARTIAL_SHARED", "MUNICIPAL", "EU_EXCLUSIVE", "EU_SHARED", "EU_SUPPORTING", "MIXED", "OTHER", "OPEN"] },
    "status": { "enum": ["EXTRACTED_NOT_ANALYSED", "REVIEWED", "HISTORICAL"] },
    "election_commitment_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commitment_id", "relationship_type", "review_status"],
        "properties": {
          "commitment_id": { "type": "string" },
          "relationship_type": { "enum": ["DERIVED_FROM_ELECTION_COMMITMENT", "MODIFIES", "COMBINES", "REPLACES", "NOT_ADOPTED"] },
          "review_status": { "enum": ["CONFIRMED", "REVIEW_REQUIRED", "REJECTED"] }
        }
      }
    }
  }
}

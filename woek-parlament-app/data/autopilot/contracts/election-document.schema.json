{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/election-document-1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "election_cycle_id", "jurisdiction_id", "party_id", "title", "source_url", "content_hash", "retrieved_at", "version", "status"],
  "properties": {
    "document_id": { "type": "string", "minLength": 3 },
    "election_cycle_id": { "type": "string", "minLength": 3 },
    "jurisdiction_id": { "type": "string", "minLength": 2 },
    "party_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "publication_date": { "type": ["string", "null"], "format": "date" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "version": { "type": "string", "minLength": 1 },
    "supersedes_document_id": { "type": ["string", "null"] },
    "status": { "enum": ["DRAFT", "PARTY_CONVENTION_DRAFT", "ADOPTED", "FINAL", "SUPERSEDED"] }
  }
}

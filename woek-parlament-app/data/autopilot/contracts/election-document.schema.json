{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/election-document-1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["election_document_id", "election_cycle_id", "jurisdiction_id", "party_id", "title", "source_url", "source_sha256", "retrieved_at", "version_status"],
  "properties": {
    "election_document_id": { "type": "string", "minLength": 3 },
    "election_cycle_id": { "type": "string", "minLength": 3 },
    "jurisdiction_id": { "type": "string", "minLength": 2 },
    "party_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "published_at": { "type": ["string", "null"], "format": "date" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "supersedes_document_id": { "type": ["string", "null"] },
    "version_status": { "enum": ["CURRENT", "SUPERSEDED", "WITHDRAWN", "OPEN"] }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/election-cycle-1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["election_cycle_id", "jurisdiction_id", "election_date", "election_cycle_state", "status", "official_source_refs", "programme_collection_status", "programme_analysis_status", "result_status", "coalition_formation_status", "new_government_status"],
  "properties": {
    "election_cycle_id": { "type": "string" },
    "jurisdiction_id": { "type": "string" },
    "election_date": { "type": "string", "format": "date" },
    "election_cycle_state": { "enum": ["PRE_ELECTION_WATCH", "PROGRAMME_ANALYSIS", "ELECTION_RESULT", "COALITION_FORMATION", "GOVERNMENT_FORMED", "CLOSED"] },
    "status": { "enum": ["ANNOUNCED", "PROGRAMMES_COLLECTING", "PROGRAMMES_REVIEW", "ELECTION_COMPLETE", "COALITION_FORMATION", "GOVERNMENT_FORMED", "CLOSED"] },
    "official_source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
    "programme_collection_status": { "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE_DEFINED_SCOPE", "OPEN"] },
    "programme_analysis_status": { "enum": ["NOT_STARTED", "IN_REVIEW", "PARTIALLY_APPROVED", "APPROVED_DEFINED_SCOPE", "OPEN"] },
    "result_status": { "enum": ["NOT_AVAILABLE", "PRELIMINARY", "FINAL_OFFICIAL"] },
    "coalition_formation_status": { "enum": ["NOT_STARTED", "EXPLORATORY", "NEGOTIATING", "AGREEMENT_PUBLISHED", "OPEN"] },
    "new_government_status": { "enum": ["NOT_FORMED", "FORMED_OFFICIAL", "OPEN"] }
  }
}

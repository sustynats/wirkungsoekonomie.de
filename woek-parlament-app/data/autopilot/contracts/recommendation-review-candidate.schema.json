{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/woek-recommendation-review-candidate-2.3.schema.json",
  "title": "WÖk RecommendationReviewCandidate 2.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "impact_case_id", "current_recommendation_version", "triggering_evidence_event_ids", "status", "created_at"],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "impact_case_id": { "type": "string", "minLength": 1 },
    "current_recommendation_version": { "type": ["string", "null"] },
    "triggering_evidence_event_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "status": { "const": "RECOMMENDATION_REVIEW_REQUIRED" },
    "created_at": { "type": "string", "format": "date-time" },
    "review_note": { "type": ["string", "null"] }
  }
}

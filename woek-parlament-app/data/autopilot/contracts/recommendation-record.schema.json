{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/woek-recommendation-record-2.3.schema.json",
  "title": "WÖk RecommendationRecord 2.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation_id", "impact_case_id", "jurisdiction_id", "recommendation_status",
    "analysis_mode", "problem_state", "target_state", "root_cause_or_binding_bottleneck", "option_set", "woek_preferred_option",
    "recommendation_core_summary", "why_preferred", "key_tradeoffs", "cascade_effects",
    "system_leverage", "first_order_effects", "second_order_effects", "third_order_effects",
    "affected_groups", "distributional_effects", "time_and_generation_effects", "resilience_effects",
    "transformation_effects", "rebound_spillover_leakage", "competence_scope", "implementation_route", "legal_constraints",
    "rights_and_boundary_conditions", "non_compensation_check", "reversibility",
    "resource_and_capacity_constraints", "safeguards", "monitoring_indicators",
    "reality_check_plan", "fallback_option", "evidence_grade", "uncertainty",
    "recommendation_version", "supersedes_recommendation_version",
    "triggering_evidence_event_ids", "public_change_summary", "fach_status", "source_refs"
  ],
  "properties": {
    "recommendation_id": { "type": "string", "minLength": 1 },
    "impact_case_id": { "type": "string", "minLength": 1 },
    "jurisdiction_id": { "type": "string", "minLength": 1 },
    "recommendation_status": {
      "enum": ["PREFERRED_OPTION", "PREFERRED_DESIGN", "DECISION_CORRIDOR", "PILOT_AND_LEARN", "KEEP_CURRENT_WITH_MODIFICATIONS", "STOP_OR_REVERSE", "NO_ROBUST_RECOMMENDATION", "OPEN"]
    },
    "analysis_mode": { "enum": ["IMPACT_POTENTIAL_EX_ANTE", "RETROSPECTIVE_DECISION_REVIEW", "CURRENT_RECOMMENDATION_AFTER_REALITY_CHECK"] },
    "decision_date": { "type": ["string", "null"], "format": "date" },
    "knowledge_cutoff_date": { "type": ["string", "null"], "format": "date" },
    "evidence_available_at_decision_time": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_only_available_later": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "hindsight_limitations": { "type": ["string", "null"] },
    "problem_state": { "type": "string", "minLength": 10 },
    "target_state": { "type": "string", "minLength": 10 },
    "root_cause_or_binding_bottleneck": { "type": "string", "minLength": 20 },
    "option_set": { "$ref": "woek-option-set-2.3.schema.json" },
    "woek_preferred_option": { "type": ["string", "null"] },
    "recommendation_core_summary": { "type": "string", "minLength": 55 },
    "why_preferred": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "key_tradeoffs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "cascade_effects": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "system_leverage": { "type": "string", "minLength": 20 },
    "first_order_effects": { "type": "array", "items": { "type": "string" } },
    "second_order_effects": { "type": "array", "items": { "type": "string" } },
    "third_order_effects": { "type": "array", "items": { "type": "string" } },
    "affected_groups": { "type": "array", "items": { "type": "string" } },
    "distributional_effects": { "type": "array", "items": { "type": "string" } },
    "time_and_generation_effects": { "type": "array", "items": { "type": "string" } },
    "resilience_effects": { "type": "array", "items": { "type": "string" } },
    "transformation_effects": { "type": "array", "items": { "type": "string" } },
    "rebound_spillover_leakage": { "type": "array", "items": { "type": "string" } },
    "competence_scope": { "type": "string", "minLength": 1 },
    "implementation_route": { "type": "string", "minLength": 1 },
    "legal_constraints": { "type": "array", "items": { "type": "string" } },
    "rights_and_boundary_conditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "non_compensation_check": { "type": "string", "minLength": 10 },
    "reversibility": { "type": "string", "minLength": 3 },
    "resource_and_capacity_constraints": { "type": "array", "items": { "type": "string" } },
    "safeguards": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "monitoring_indicators": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "reality_check_plan": { "type": "string", "minLength": 10 },
    "fallback_option": { "type": ["string", "null"] },
    "evidence_grade": { "enum": ["HIGH", "MEDIUM", "LOW", "NOT_ASSESSABLE"] },
    "uncertainty": { "type": "string", "minLength": 3 },
    "recommendation_version": { "type": "string", "minLength": 1 },
    "supersedes_recommendation_version": { "type": ["string", "null"] },
    "triggering_evidence_event_ids": { "type": "array", "items": { "type": "string" } },
    "public_change_summary": { "type": "string", "minLength": 10 },
    "fach_status": { "enum": ["APPROVED", "APPROVED_WITH_OPEN_DATA", "OPEN", "SUPERSEDED", "BLOCKED"] },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "analysis_mode": { "const": "RETROSPECTIVE_DECISION_REVIEW" } } },
      "then": {
        "required": ["decision_date", "knowledge_cutoff_date", "evidence_available_at_decision_time", "evidence_only_available_later", "hindsight_limitations"],
        "properties": {
          "decision_date": { "type": "string", "format": "date" },
          "knowledge_cutoff_date": { "type": "string", "format": "date" },
          "evidence_available_at_decision_time": { "type": "array", "minItems": 1 },
          "hindsight_limitations": { "type": "string", "minLength": 10 }
        }
      }
    }
  ]
}

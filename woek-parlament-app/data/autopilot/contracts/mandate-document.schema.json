{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/governing-mandate-document-1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["mandate_document_id", "jurisdiction_id", "document_type", "title", "source_url", "version_hash"],
  "properties": {
    "mandate_document_id": { "type": "string" },
    "jurisdiction_id": { "type": "string" },
    "document_type": { "enum": ["COALITION_AGREEMENT", "GOVERNMENT_AGREEMENT", "COOPERATION_AGREEMENT", "POLITICAL_GUIDELINES", "GOVERNMENT_PROGRAMME", "PRIORITY_DOCUMENT", "MISSION_LETTER", "WORK_PROGRAMME", "STRATEGIC_AGENDA", "OTHER"] },
    "title": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "published_at": { "type": ["string", "null"], "format": "date" },
    "version_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

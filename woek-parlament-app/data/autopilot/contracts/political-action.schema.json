{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/political-action-1.0.schema.json",
  "description": "Jurisdiktionsübergreifender amtlicher Handlungsgegenstand. Wirkungsanalyse bleibt im WÖkImpactCase.",
  "type": "object",
  "additionalProperties": false,
  "required": ["political_action_id", "jurisdiction_id", "object_type", "action_type", "title_official", "lifecycle_status", "responsible_institution_ids", "source_event_ids", "official_source_refs", "created_at", "updated_at"],
  "properties": {
    "political_action_id": { "type": "string", "minLength": 3 },
    "jurisdiction_id": { "type": "string", "minLength": 2 },
    "object_type": { "enum": ["FEDERAL_GOVERNMENT_ACTION", "STATE_GOVERNMENT_ACTION", "STATE_PARLIAMENTARY_CASE", "FEDERAL_COUNCIL_POSITION", "COMMISSION_ACTION", "EU_PARLIAMENTARY_CASE", "COUNCIL_POSITION", "TRILOGUE_EVENT", "LEGAL_ACT", "IMPLEMENTATION_OBJECT", "EXTERNAL_ACTOR_EVENT"] },
    "action_type": { "type": "string", "minLength": 2 },
    "title_official": { "type": "string", "minLength": 2 },
    "lifecycle_status": { "type": "string", "minLength": 2 },
    "responsible_institution_ids": { "type": "array", "items": { "type": "string" } },
    "source_event_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "official_source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
    "official_identifiers": { "type": "object", "additionalProperties": { "type": ["string", "array", "null"] } },
    "competence_scope": { "enum": ["FEDERAL", "LAND_FULL", "LAND_PARTIAL_SHARED", "MUNICIPAL", "EU", "EU_EXCLUSIVE", "EU_SHARED", "EU_SUPPORTING", "MIXED", "OTHER", "OPEN"] },
    "competence_review_status": { "enum": ["OPEN", "REVIEW_REQUIRED", "APPROVED", "BLOCKED"] },
    "competence_review_ref": { "type": ["string", "null"] },
    "legal_feasibility_status": { "enum": ["CLEAR_LAND_ROUTE", "LAND_ROUTE_WITH_CONSTRAINTS", "REQUIRES_MUNICIPAL_ACTION", "REQUIRES_FEDERAL_ACTION", "REQUIRES_EU_ACTION", "REQUIRES_INTERSTATE_COORDINATION", "FEDERAL_PREEMPTION_RISK", "HIGHER_LAW_CONFLICT_RISK", "LIKELY_NOT_IMPLEMENTABLE_AS_STATED", "OPEN"] },
    "legal_basis": { "type": "array", "items": { "type": "string" } },
    "inherited_legislative_file": { "type": "boolean" },
    "identity_review_status": { "enum": ["CONFIRMED", "REVIEW_REQUIRED", "BLOCKED"] },
    "publication_status": { "enum": ["INTERNAL", "FACTS_APPROVED", "BLOCKED"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}

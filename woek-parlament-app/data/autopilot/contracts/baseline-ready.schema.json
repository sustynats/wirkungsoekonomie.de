{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/political-baseline-ready-1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline_id", "jurisdiction_id", "term_id", "created_at", "source_cursor", "objects", "source_refs", "coverage", "open_data_issues", "candidate_impact_case_ids", "content_hash"],
  "properties": {
    "baseline_id": { "type": "string", "minLength": 3 },
    "jurisdiction_id": { "type": "string", "minLength": 2 },
    "term_id": { "type": "string", "minLength": 2 },
    "created_at": { "type": "string", "format": "date-time" },
    "source_cursor": { "type": ["string", "null"] },
    "objects": { "type": "array", "items": { "type": "string" } },
    "source_refs": { "type": "array", "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
    "coverage": { "enum": ["COMPLETE_ENUMERATED_SOURCE", "BEST_EFFORT_DEFINED_SOURCE_SCOPE", "PARTIAL", "SOURCE_UNAVAILABLE", "UNKNOWN"] },
    "open_data_issues": { "type": "array", "items": { "type": "string" } },
    "candidate_impact_case_ids": { "type": "array", "items": { "type": "string" } },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

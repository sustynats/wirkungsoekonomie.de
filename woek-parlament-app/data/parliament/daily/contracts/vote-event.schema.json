{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirkungsoekonomie.de/contracts/parliament-vote-event-1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["vote_event_id", "parliamentary_case_id", "date", "question_official", "vote_type", "result", "source_refs"],
  "properties": {
    "vote_event_id": { "type": "string", "minLength": 4 },
    "parliamentary_case_id": { "type": ["string", "null"] },
    "date": { "type": "string", "format": "date" },
    "question_official": { "type": "string", "minLength": 1 },
    "vote_type": { "type": "string", "minLength": 1 },
    "result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["yes", "no", "abstain", "other"],
      "properties": {
        "yes": { "type": ["integer", "null"], "minimum": 0 },
        "no": { "type": ["integer", "null"], "minimum": 0 },
        "abstain": { "type": ["integer", "null"], "minimum": 0 },
        "other": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    }
  }
}

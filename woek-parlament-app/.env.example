# The currently published DIP key can be used as a server-side transition key until
# its published expiry. Never commit it or expose it through NEXT_PUBLIC_* values.
DIP_API_KEY=

# Configure only in the editorial deployment; public routes never expose these values.
NEXT_PUBLIC_PORTAL_URL=https://parlament.wirkungsoekonomie.de
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# A high-entropy private value for the Vercel Cron invocation. It is never used
# in a public URL or exposed to browser code.
IMPORT_CRON_SECRET=
# Vercel Cron sends this value as the Bearer token to the daily government
# impact ingest route. Keep it separate from editorial and import credentials.
CRON_SECRET=
# Separate credential for a trusted worker that may create internal editorial
# task packages.  It cannot publish cases or bypass the editorial workflow.
EDITORIAL_WORKER_SECRET=
# Deliberately off until the shared WÖK-AI provider is selected and reviewed.
# The limits constrain a bounded JSON microtask; they never authorize a whole
# dossier upload or an autonomous assessment.
EDITORIAL_AI_ENABLED=false
AI_MAX_INPUT_TOKENS_PER_MICROTASK=1200
AI_MAX_OUTPUT_TOKENS_PER_MICROTASK=300
AI_MAX_AUTOMATIC_MICROTASKS_PER_CASE=3
AI_MAX_TOTAL_TOKENS_PER_CASE=4000
DIP_LOOKAHEAD_DAYS=10
# The historical WÖk balance covers the current Federal Government from this
# date.  It is deliberately distinct from the start of the 21st Wahlperiode.
HISTORICAL_WOEK_BACKFILL_START=2025-05-06
DIP_WAHLPERIODE=21
# The importer persists its DIP cursor after every page.  This is the number
# of pages processed per serverless invocation, never a completeness limit.
DIP_IMPORT_PAGES_PER_INVOCATION=3

# Server-only Dropbox connection for the fachlich freigegebene daily handoff.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
WOEK_DROPBOX_ROOT=/WOEK
# Fail-closed during INITIAL_BOOTSTRAP_2_3. Set to NORMAL only after the
# external WÖk end audit explicitly releases recurring writers.
WOEK_AUTOPILOT_RUNTIME_MODE=INITIAL_BOOTSTRAP_2_3
DROPBOX_GOVERNMENT_ANALYSIS_PATH=/WOEK/WOEK-REGIERUNG-WIRKUNG-FACHRELEASE-2.0/analysis
DROPBOX_GOVERNMENT_INGEST_STATE_PATH=/WOEK/WOEK-REGIERUNG-WIRKUNG-FACHRELEASE-2.0/technical-ingest

# Vercel production deploy hook. It is called only after every fachlich and
# technically required deployment gate has passed.
GOVERNMENT_DAILY_PRODUCTION_DEPLOY_HOOK=

# Twice-daily Parliament delivery and fach approval handoff.
DROPBOX_PARLIAMENT_DAILY_PATH=/WOEK/WOEK-PARLAMENT-DAILY
PARLIAMENT_DAILY_PRODUCTION_DEPLOY_HOOK=

# Protected operational status. Use separate high-entropy values and do not
# expose either through NEXT_PUBLIC_* variables.
AUTOPILOT_STATUS_USER=
AUTOPILOT_STATUS_PASSWORD=

# The daily digest is disabled until the database migration, privacy notice,
# sender identity and production SMTP transport have all been checked. It is
# sent only for fach-approved changes verified on the public portal.
WIRKUNGSRADAR_DAILY_DIGEST_ENABLED=false
WIRKUNGSRADAR_UNSUBSCRIBE_SIGNING_SECRET=
WIRKUNGSRADAR_DAILY_DIGEST_BATCH_SIZE=50
WIRKUNGSRADAR_SMTP_HOST=smtp.ionos.de
WIRKUNGSRADAR_SMTP_PORT=587
WIRKUNGSRADAR_SMTP_USER=
WIRKUNGSRADAR_SMTP_PASSWORD=
WIRKUNGSRADAR_SMTP_FROM="Institut für Wirkungsökonomie <newsletter@wirkungsoekonomie.de>"
WIRKUNGSRADAR_SMTP_REPLY_TO=
WIRKUNGSRADAR_SMTP_TEST_RECIPIENT=

# Institute bot direct message notifications for completed review packages.
DISCORD_INSTITUTE_BOT_TOKEN=
DISCORD_OWNER_USER_ID=

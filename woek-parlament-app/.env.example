# The currently published DIP key can be used as a server-side transition key until
# its published expiry. Never commit it or expose it through NEXT_PUBLIC_* values.
DIP_API_KEY=

# Configure only in the editorial deployment; public routes never expose these values.
NEXT_PUBLIC_PORTAL_URL=https://parlament.wirkungsoekonomie.de
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# A high-entropy private value for the Vercel Cron invocation. It is never used
# in a public URL or exposed to browser code.
IMPORT_CRON_SECRET=
# Separate credential for a trusted worker that may create internal editorial
# task packages.  It cannot publish cases or bypass the editorial workflow.
EDITORIAL_WORKER_SECRET=
DIP_LOOKAHEAD_DAYS=10
DIP_WAHLPERIODE=21
# At most 100 DIP positions per page; keep the number bounded for a serverless run.
DIP_IMPORT_MAX_PAGES=10

{
  "name": "woek-parlament-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:accessibility",
    "build": "node scripts/quality/check-privacy-governance.mjs && node scripts/quality/check-release-safety.mjs --scope=repository && node scripts/quality/verify-public-documents.mjs && node scripts/quality/check-public-content-completeness.mjs && next build && node scripts/quality/check-release-safety.mjs --scope=release && node scripts/quality/verify-public-documents.mjs && node scripts/quality/check-public-content-completeness.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:accessibility": "node scripts/quality/audit-accessibility-baseline.mjs",
    "check:accessibility": "node scripts/quality/audit-accessibility-baseline.mjs --strict",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node scripts/run-parliament-migrations.mjs",
    "db:verify": "node scripts/verify-parliament-db.mjs",
    "storage:report": "node scripts/storage-report.mjs",
    "supabase:connect": "node scripts/connect-supabase.mjs",
    "backfill:historical": "tsx scripts/run-historical-backfill.ts",
    "backfill:historical:step": "tsx scripts/run-historical-backfill-step.ts",
    "documents:reindex-chunks": "tsx scripts/reindex-document-chunks.ts",
    "review:export-upcoming": "tsx scripts/export-upcoming-review-batch.ts",
    "review:export-batch": "tsx scripts/export-review-batch.ts",
    "reviews:prepare-upcoming": "tsx scripts/run-upcoming-preparation.ts",
    "review:export-mandate": "tsx scripts/export-mandate-review-batch.ts",
    "review:export-final-historical": "tsx scripts/export-final-historical-review.ts",
    "review:import-final-evidence": "tsx scripts/import-final-evidence-archive.ts",
    "review:validate-final-release": "tsx scripts/validate-final-release-delivery.ts",
    "review:validate-final-release:archive": "node scripts/quality/validate-final-release-delivery.mjs",
    "review:import-final-release": "tsx scripts/import-final-release-delivery.ts",
    "review:import-final-release:resume": "node scripts/import-final-release-delivery.mjs",
    "review:generate-public-working-acts": "tsx scripts/generate-public-working-acts.ts",
    "review:export-ex-ante-mapping": "tsx scripts/export-ex-ante-mapping-package.ts",
    "review:export-historical-evidence": "tsx scripts/export-historical-evidence-research-package.ts",
    "reviews:materialize-follow-up-tasks": "tsx scripts/materialize-review-follow-up-tasks.ts",
    "review:queue-existing-evidence": "tsx scripts/queue-existing-evidence-candidates.ts",
    "review:check-evidence-availability": "tsx scripts/check-evidence-availability.ts",
    "votes:import-official": "tsx scripts/import-official-named-votes.ts",
    "votes:reconcile-official": "tsx scripts/reconcile-official-named-votes.ts",
    "votes:link-decision-units": "tsx scripts/link-named-vote-decision-units.ts",
    "privacy:check": "node scripts/quality/check-privacy-governance.mjs && node scripts/quality/check-release-safety.mjs --scope=repository",
    "privacy:release": "node scripts/quality/check-release-safety.mjs --scope=release",
    "publications:verify": "node scripts/quality/verify-public-documents.mjs",
    "publications:deep-verify": "node scripts/quality/verify-public-documents.mjs --deep"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "15.5.13",
    "nodemailer": "^9.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.13",
    "tsx": "^4.20.6",
    "typescript": "5.7.2"
  }
}
